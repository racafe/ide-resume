---
/**
 * CustomizePanel.astro - Customization/Settings sidebar panel
 * Replaces the file explorer when Extensions icon is clicked
 * Styled like VS Code settings UI
 */
---

<!-- Customize Panel (replaces sidebar content when active) -->
<div id="customize-panel" class="customize-panel hidden">
  <div class="customize-header">
    <svg class="customize-header-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="3" y="3" width="8" height="8" rx="1"></rect>
      <rect x="13" y="3" width="8" height="8" rx="1"></rect>
      <rect x="3" y="13" width="8" height="8" rx="1"></rect>
      <rect x="13" y="13" width="8" height="8" rx="1"></rect>
    </svg>
    <span>Customize</span>
  </div>

  <div class="customize-content">
    <!-- Theme Section -->
    <div class="customize-section">
      <div class="customize-section-header">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
        <span>Appearance</span>
      </div>
      <div class="customize-section-content">
        <div class="customize-setting">
          <div class="customize-setting-label">
            <span class="customize-setting-name">Color Theme</span>
            <span class="customize-setting-desc">Specifies the color theme used in the workbench</span>
          </div>
          <select id="color-theme-select" class="customize-select">
            <option value="dark-plus">Dark+ (default)</option>
            <option value="light">Light</option>
            <option value="monokai">Monokai</option>
          </select>
        </div>

        <div class="customize-setting">
          <div class="customize-setting-label">
            <span class="customize-setting-name">Font Size</span>
            <span class="customize-setting-desc">Controls the font size in pixels</span>
          </div>
          <select id="font-size-select" class="customize-select">
            <option value="12">12px</option>
            <option value="13" selected>13px (default)</option>
            <option value="14">14px</option>
            <option value="15">15px</option>
            <option value="16">16px</option>
          </select>
        </div>
      </div>
    </div>

    <!-- About Section -->
    <div class="customize-section">
      <div class="customize-section-header">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
        <span>About</span>
      </div>
      <div class="customize-section-content">
        <div class="customize-about">
          <div class="customize-about-item">
            <span class="customize-about-label">Version</span>
            <span class="customize-about-value">1.0.0</span>
          </div>
          <div class="customize-about-item">
            <span class="customize-about-label">Built with</span>
            <span class="customize-about-value">Astro + Tailwind</span>
          </div>
          <div class="customize-about-item">
            <span class="customize-about-label">Author</span>
            <span class="customize-about-value">Rafael Carrion</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Links Section -->
    <div class="customize-section">
      <div class="customize-section-header">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
        <span>Links</span>
      </div>
      <div class="customize-section-content">
        <div class="customize-links">
          <a href="https://github.com/racafe/racafe-astro" target="_blank" rel="noopener noreferrer" class="customize-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
            </svg>
            <span>View Source on GitHub</span>
            <svg class="customize-link-external" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
          <a href="https://linkedin.com/in/rafaelcarrion" target="_blank" rel="noopener noreferrer" class="customize-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
            </svg>
            <span>Connect on LinkedIn</span>
            <svg class="customize-link-external" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <div class="customize-footer">
    <span class="syntax-comment">// Settings are stored locally</span>
  </div>
</div>

<script>
  declare global {
    interface Window {
      openCustomizePanel?: () => void;
      closeCustomizePanel?: () => void;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const customizePanel = document.getElementById('customize-panel');
    const gitStatsPanel = document.getElementById('git-stats-panel');
    const sidebar = document.getElementById('sidebar');
    const fileTree = document.getElementById('file-tree');
    const sidebarHeader = sidebar?.querySelector('.sidebar-header');
    const extensionsBtn = document.querySelector('.activity-bar-icon[title="Extensions"]');
    const explorerBtn = document.querySelector('.activity-bar-icon[title="Explorer"]');
    const sourceControlBtn = document.querySelector('.activity-bar-icon[title="Source Control"]');

    // Color theme select
    const colorThemeSelect = document.getElementById('color-theme-select') as HTMLSelectElement;

    // Load saved theme from localStorage
    const savedTheme = localStorage.getItem('ide-color-theme') || 'dark-plus';
    if (colorThemeSelect) {
      colorThemeSelect.value = savedTheme;
    }
    applyTheme(savedTheme);

    // Handle theme changes
    colorThemeSelect?.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      const theme = target.value;
      applyTheme(theme);
      localStorage.setItem('ide-color-theme', theme);
    });

    function applyTheme(theme: string): void {
      // Remove any existing theme data attribute (for dark-plus, use no attribute)
      if (theme === 'dark-plus') {
        document.documentElement.removeAttribute('data-theme');
      } else {
        document.documentElement.setAttribute('data-theme', theme);
      }
    }

    // Font size select
    const fontSizeSelect = document.getElementById('font-size-select') as HTMLSelectElement;

    // Load saved font size from localStorage
    const savedFontSize = localStorage.getItem('ide-font-size');
    if (savedFontSize && fontSizeSelect) {
      fontSizeSelect.value = savedFontSize;
      applyFontSize(savedFontSize);
    }

    // Handle font size changes
    fontSizeSelect?.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      const size = target.value;
      applyFontSize(size);
      localStorage.setItem('ide-font-size', size);
    });

    function applyFontSize(size: string): void {
      document.documentElement.style.setProperty('--code-font-size', `${size}px`);
      // Update editor content font size
      const editorContent = document.querySelector('.editor-content');
      if (editorContent) {
        (editorContent as HTMLElement).style.fontSize = `${size}px`;
      }
    }

    // Open customize panel
    function openCustomizePanel(): void {
      // Hide file tree and git stats panel
      fileTree?.classList.add('hidden');
      gitStatsPanel?.classList.add('hidden');
      customizePanel?.classList.remove('hidden');

      // Update sidebar header
      if (sidebarHeader) {
        sidebarHeader.textContent = 'Customize';
      }

      // Update active states
      explorerBtn?.classList.remove('active');
      sourceControlBtn?.classList.remove('active');
      extensionsBtn?.classList.add('active');
    }

    // Close customize panel (show file explorer)
    function closeCustomizePanel(): void {
      // Show file tree, hide customize panel
      fileTree?.classList.remove('hidden');
      customizePanel?.classList.add('hidden');

      // Update sidebar header
      if (sidebarHeader) {
        sidebarHeader.textContent = 'Explorer';
      }

      // Update active states
      extensionsBtn?.classList.remove('active');
      sourceControlBtn?.classList.remove('active');
      explorerBtn?.classList.add('active');
    }

    // Event: Extensions button click
    extensionsBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      const isActive = extensionsBtn.classList.contains('active');
      if (isActive) {
        closeCustomizePanel();
      } else {
        openCustomizePanel();
      }
    });

    // Event: Explorer button click (to close customize panel)
    explorerBtn?.addEventListener('click', () => {
      if (customizePanel && !customizePanel.classList.contains('hidden')) {
        closeCustomizePanel();
      }
    });

    // Expose functions globally
    window.openCustomizePanel = openCustomizePanel;
    window.closeCustomizePanel = closeCustomizePanel;
  });
</script>
