---
/**
 * ChatPanel.astro - Slide-in chat panel (VS Code style)
 * Slides in from the right side with smooth 60fps animation
 */
---

<!-- Overlay for clicking outside to close -->
<div id="chat-overlay" class="chat-overlay" aria-hidden="true"></div>

<!-- Chat Panel -->
<aside id="chat-panel" class="chat-panel" role="dialog" aria-label="Chat with AI assistant" aria-modal="true">
  <!-- Panel Header -->
  <header class="chat-panel-header">
    <div class="chat-panel-title">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path
          d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
        >
        </path>
      </svg>
      <span>Ask AI about Rafael</span>
    </div>
    <div class="chat-panel-actions">
      <button id="chat-clear" class="chat-panel-clear" aria-label="Clear chat history" title="Clear chat">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
      </button>
      <button id="chat-panel-close" class="chat-panel-close" aria-label="Close chat panel" title="Close (Esc)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6L18 18"></path>
        </svg>
      </button>
    </div>
  </header>

  <!-- Chat Messages Area -->
  <div id="chat-messages" class="chat-messages">
    <!-- Welcome Message with Starter Questions -->
    <div id="chat-welcome" class="chat-message chat-message-assistant">
      <div class="chat-message-avatar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"
          >
          </path>
        </svg>
      </div>
      <div class="chat-message-content">
        <p>
          Hi! I'm an AI assistant that can answer questions about Rafael's experience, skills, and background. Feel free
          to ask me anything!
        </p>
        <p class="chat-suggestions-label">Try asking:</p>
        <div class="chat-suggestions">
          <button class="chat-suggestion" data-question="What technologies does Rafael work with?">
            What technologies does Rafael work with?
          </button>
          <button class="chat-suggestion" data-question="Tell me about Rafael's experience">
            Tell me about his experience
          </button>
          <button class="chat-suggestion" data-question="What is Rafael currently working on?">
            What is he currently working on?
          </button>
          <button class="chat-suggestion" data-question="What projects has Rafael built?">
            What projects has he built?
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Chat Input Area -->
  <form id="chat-form" class="chat-input-area">
    <div class="chat-input-container">
      <textarea
        id="chat-input"
        class="chat-input"
        placeholder="Ask about Rafael's skills, experience, or background..."
        rows="1"
        aria-label="Type your message"
      >
      </textarea>
      <button type="submit" id="chat-submit" class="chat-submit" aria-label="Send message" disabled>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 2L11 13M22 2L15 22L11 13M22 2L2 9L11 13"></path>
        </svg>
      </button>
    </div>
    <p class="chat-disclaimer">AI responses are generated and may not be 100% accurate.</p>
  </form>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const chatForm = document.getElementById('chat-form') as HTMLFormElement;
    const chatInput = document.getElementById('chat-input') as HTMLTextAreaElement;
    const chatSubmit = document.getElementById('chat-submit') as HTMLButtonElement;
    const chatMessages = document.getElementById('chat-messages');
    const suggestions = document.querySelectorAll('.chat-suggestion');
    const welcomeMessage = document.getElementById('chat-welcome');
    const clearButton = document.getElementById('chat-clear');

    // ========================================================================
    // Conversation History Management
    // ========================================================================

    interface ChatMessage {
      role: 'user' | 'model';
      parts: { text: string }[];
    }

    const STORAGE_KEY = 'chat-history';
    const MAX_HISTORY_LENGTH = 40; // Keep last 40 messages (20 exchanges)
    const MAX_TOTAL_CHARS = 16000; // ~4000 tokens estimate for context management

    // Load conversation history from sessionStorage
    function loadHistory(): ChatMessage[] {
      try {
        const stored = sessionStorage.getItem(STORAGE_KEY);
        if (stored) {
          return JSON.parse(stored) as ChatMessage[];
        }
      } catch {
        // Invalid JSON, start fresh
        sessionStorage.removeItem(STORAGE_KEY);
      }
      return [];
    }

    // Save conversation history to sessionStorage
    function saveHistory(history: ChatMessage[]): void {
      try {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(history));
      } catch {
        // Storage full - trim old messages and try again
        const trimmed = trimHistory(history.slice(Math.floor(history.length / 2)));
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(trimmed));
      }
    }

    // Trim history to stay within limits
    function trimHistory(history: ChatMessage[]): ChatMessage[] {
      // Trim by message count
      let trimmed = history.slice(-MAX_HISTORY_LENGTH);

      // Trim by total character count to manage context window
      let totalChars = trimmed.reduce((sum, msg) => sum + msg.parts[0].text.length, 0);

      while (totalChars > MAX_TOTAL_CHARS && trimmed.length > 2) {
        // Remove oldest pair (user + model)
        trimmed = trimmed.slice(2);
        totalChars = trimmed.reduce((sum, msg) => sum + msg.parts[0].text.length, 0);
      }

      return trimmed;
    }

    // Add message to history
    function addToHistory(role: 'user' | 'model', text: string): void {
      const history = loadHistory();
      history.push({ role, parts: [{ text }] });
      saveHistory(trimHistory(history));
    }

    // Clear conversation history
    function clearHistory(): void {
      sessionStorage.removeItem(STORAGE_KEY);
    }

    // Get history formatted for API
    function getHistoryForApi(): ChatMessage[] {
      return loadHistory();
    }

    // ========================================================================
    // UI State Management
    // ========================================================================

    // Track if user has interacted (for hiding starter questions)
    let hasInteracted = loadHistory().length > 0;

    // Hide starter questions after first interaction
    function hideStarterQuestions() {
      if (!hasInteracted && welcomeMessage) {
        hasInteracted = true;
        welcomeMessage.classList.add('chat-welcome-hidden');
      }
    }

    // Restore previous conversation on load
    function restoreConversation(): void {
      const history = loadHistory();

      if (history.length > 0) {
        // Hide welcome message since we have history
        hideStarterQuestions();

        // Render all previous messages
        history.forEach((msg) => {
          const role = msg.role === 'user' ? 'user' : 'assistant';
          renderMessage(msg.parts[0].text, role);
        });

        // Scroll to bottom after rendering
        scrollToBottom();
      }
    }

    // Reset chat to initial state
    function resetChat(): void {
      // Clear history
      clearHistory();

      // Remove all messages except welcome
      if (chatMessages) {
        const messages = chatMessages.querySelectorAll('.chat-message:not(#chat-welcome)');
        messages.forEach((msg) => msg.remove());
      }

      // Show welcome message again
      if (welcomeMessage) {
        welcomeMessage.classList.remove('chat-welcome-hidden');
      }

      hasInteracted = false;
    }

    // ========================================================================
    // Event Handlers
    // ========================================================================

    // Auto-resize textarea
    chatInput?.addEventListener('input', () => {
      chatInput.style.height = 'auto';
      chatInput.style.height = Math.min(chatInput.scrollHeight, 120) + 'px';

      // Enable/disable submit button
      const hasContent = chatInput.value.trim().length > 0;
      chatSubmit.disabled = !hasContent;
    });

    // Handle Enter key (submit on Enter, new line on Shift+Enter)
    chatInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        if (chatInput.value.trim()) {
          chatForm.dispatchEvent(new Event('submit', { cancelable: true }));
        }
      }
    });

    // Handle suggestion clicks
    suggestions.forEach((suggestion) => {
      suggestion.addEventListener('click', () => {
        const question = suggestion.getAttribute('data-question');
        if (question && chatInput) {
          chatInput.value = question;
          chatInput.dispatchEvent(new Event('input'));
          chatForm.dispatchEvent(new Event('submit', { cancelable: true }));
        }
      });
    });

    // Handle clear chat button
    clearButton?.addEventListener('click', () => {
      resetChat();
    });

    // Session ID for rate limiting
    let sessionId = sessionStorage.getItem('chat-session-id');
    if (!sessionId) {
      sessionId = crypto.randomUUID();
      sessionStorage.setItem('chat-session-id', sessionId);
    }

    // Send message function for reuse (initial send and retry)
    async function sendChatMessage(message: string, isRetry = false): Promise<void> {
      // Hide starter questions on first interaction
      if (!isRetry) {
        hideStarterQuestions();

        // Add user message to chat UI and history
        renderMessage(message, 'user');
        addToHistory('user', message);
      }

      // Show typing indicator
      const typingId = showTypingIndicator();

      try {
        // Get conversation history for context
        const history = getHistoryForApi();
        // Remove the last message (current user message) since we send it separately
        const historyWithoutCurrent = history.slice(0, -1);

        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Session-ID': sessionId || '',
          },
          body: JSON.stringify({
            message,
            history: historyWithoutCurrent,
          }),
        });

        // Remove typing indicator
        removeTypingIndicator(typingId);

        const data = await response.json();

        if (!response.ok) {
          // Handle error with structured error info
          const errorType = data.errorType || 'unknown';
          const retryable = data.retryable !== false;
          const errorMessage = data.error || 'Something went wrong. Please try again.';

          // Provide user-friendly messages based on error type
          let displayMessage = errorMessage;
          if (errorType === 'rate_limit') {
            displayMessage = "I'm getting a lot of questions right now. Please wait a moment and try again.";
          } else if (errorType === 'network') {
            displayMessage = 'Unable to reach the AI service. Please check your internet connection and try again.';
          } else if (errorType === 'api_error') {
            displayMessage =
              "I'm having trouble generating a response right now. Please try again, or feel free to contact Rafael directly.";
          }

          renderMessage(displayMessage, 'assistant', true, {
            errorType,
            retryable,
            retryCallback: retryable ? () => sendChatMessage(message, true) : undefined,
          });
          return;
        }

        renderMessage(data.response, 'assistant');
        addToHistory('model', data.response);
      } catch {
        removeTypingIndicator(typingId);

        // Network error (fetch failed completely)
        renderMessage(
          'Unable to connect. Please check your internet connection and try again, or contact Rafael directly.',
          'assistant',
          true,
          {
            errorType: 'network',
            retryable: true,
            retryCallback: () => sendChatMessage(message, true),
          }
        );
      }
    }

    // Handle form submission
    chatForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const message = chatInput.value.trim();
      if (!message) return;

      // Clear input
      chatInput.value = '';
      chatInput.style.height = 'auto';
      chatSubmit.disabled = true;

      await sendChatMessage(message);
    });

    // ========================================================================
    // UI Helpers
    // ========================================================================

    interface ErrorOptions {
      errorType?: 'rate_limit' | 'validation' | 'api_error' | 'network' | 'unknown';
      retryable?: boolean;
      retryCallback?: () => void;
    }

    function renderMessage(content: string, role: 'user' | 'assistant', isError = false, errorOptions?: ErrorOptions) {
      const messageDiv = document.createElement('div');
      messageDiv.className = `chat-message chat-message-${role}${isError ? ' chat-message-error' : ''}`;

      if (role === 'assistant') {
        let errorActions = '';

        if (isError && errorOptions) {
          // Build error-specific actions
          const retryButton =
            errorOptions.retryable && errorOptions.retryCallback
              ? `<button class="chat-error-retry" aria-label="Retry sending message">Try Again</button>`
              : '';

          const emailLink =
            errorOptions.errorType === 'api_error' || errorOptions.errorType === 'network'
              ? `<a href="mailto:rafael.carrion.work@gmail.com?subject=Chat%20Issue%20Report" class="chat-error-email">Contact Rafael directly</a>`
              : '';

          if (retryButton || emailLink) {
            errorActions = `<div class="chat-error-actions">${retryButton}${emailLink}</div>`;
          }
        }

        messageDiv.innerHTML = `
          <div class="chat-message-avatar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"></path>
            </svg>
          </div>
          <div class="chat-message-content">
            <p>${escapeHtml(content)}</p>
            ${errorActions}
          </div>
        `;

        // Attach retry event listener if applicable
        if (isError && errorOptions?.retryable && errorOptions?.retryCallback) {
          const retryBtn = messageDiv.querySelector('.chat-error-retry');
          retryBtn?.addEventListener('click', () => {
            // Remove error message on retry
            messageDiv.remove();
            errorOptions.retryCallback?.();
          });
        }
      } else {
        messageDiv.innerHTML = `
          <div class="chat-message-content">
            <p>${escapeHtml(content)}</p>
          </div>
        `;
      }

      chatMessages?.appendChild(messageDiv);
      scrollToBottom();
    }

    function showTypingIndicator(): string {
      const id = 'typing-' + Date.now();
      const typingDiv = document.createElement('div');
      typingDiv.id = id;
      typingDiv.className = 'chat-message chat-message-assistant chat-typing';
      typingDiv.innerHTML = `
        <div class="chat-message-avatar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"></path>
          </svg>
        </div>
        <div class="chat-message-content">
          <div class="chat-typing-dots">
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>
      `;
      chatMessages?.appendChild(typingDiv);
      scrollToBottom();
      return id;
    }

    function removeTypingIndicator(id: string) {
      const typingDiv = document.getElementById(id);
      typingDiv?.remove();
    }

    function scrollToBottom() {
      if (chatMessages) {
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }
    }

    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // ========================================================================
    // Mobile Keyboard Handling
    // ========================================================================

    // Handle virtual keyboard on mobile devices
    // This ensures the input field stays visible when the keyboard is open
    function setupMobileKeyboardHandling(): void {
      const chatPanel = document.getElementById('chat-panel');
      const chatInputArea = document.querySelector('.chat-input-area') as HTMLElement;

      // Use visualViewport API for better keyboard detection (supported on modern mobile browsers)
      const viewport = window.visualViewport;
      if (viewport) {
        let initialHeight = viewport.height;

        viewport.addEventListener('resize', () => {
          // Keyboard is likely open if viewport height decreased significantly
          const keyboardOpen = viewport.height < initialHeight * 0.75;

          if (chatPanel?.classList.contains('open')) {
            if (keyboardOpen) {
              chatPanel.classList.add('keyboard-open');
              // Scroll input into view
              chatInputArea?.scrollIntoView({ block: 'end', behavior: 'smooth' });
            } else {
              chatPanel.classList.remove('keyboard-open');
            }
          }
        });

        // Update initial height when panel opens (handles orientation changes)
        const observer = new MutationObserver(() => {
          if (chatPanel?.classList.contains('open')) {
            initialHeight = viewport.height;
          }
        });

        if (chatPanel) {
          observer.observe(chatPanel, { attributes: true, attributeFilter: ['class'] });
        }
      }

      // Fallback: scroll input into view on focus for older browsers
      chatInput?.addEventListener('focus', () => {
        // Small delay to let keyboard animation complete
        setTimeout(() => {
          chatInput.scrollIntoView({ block: 'center', behavior: 'smooth' });
        }, 300);
      });
    }

    // ========================================================================
    // Initialize
    // ========================================================================

    // Restore conversation from session storage on page load
    restoreConversation();

    // Setup mobile keyboard handling
    setupMobileKeyboardHandling();
  });
</script>
