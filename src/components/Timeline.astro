---
export interface TimelineItem {
  id: string;
  company: string;
  position: string;
  dateRange: string;
  hash?: string;
  highlights: string[];
  technologies?: string[];
  isVolunteer?: boolean;
}

export interface Props {
  items: TimelineItem[];
  title?: string;
  footerText?: string;
}

const { items, title = 'TIMELINE', footerText = 'Career journey continues...' } = Astro.props;
---

<div class="timeline-panel max-w-4xl">
  <!-- Panel Header -->
  <div class="timeline-header">
    <div class="timeline-header-title">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M12 3v6m0 6v6"></path>
      </svg>
      <span>{title}</span>
    </div>
    <span class="timeline-header-count">{items.length} entries</span>
  </div>

  <!-- Timeline Entries -->
  <div class="timeline-entries">
    {
      items.map((item, index) => {
        const isFirst = index === 0;
        const isLast = index === items.length - 1;
        const hash = item.hash || `#${item.id}`;

        return (
          <div class="timeline-entry" data-entry={item.id} data-expanded={isFirst ? 'true' : 'false'}>
            <button class="timeline-commit" aria-expanded={isFirst ? 'true' : 'false'}>
              <div class="commit-graph">
                <div class="commit-line" />
                <div class={`commit-dot ${item.isVolunteer ? 'volunteer' : ''}`} />
                <div class={`commit-line-bottom ${isLast ? 'faded' : ''}`} />
              </div>
              <div class="commit-content">
                <div class="commit-header">
                  <svg
                    class={`commit-icon w-4 h-4 ${item.isVolunteer ? 'volunteer' : ''}`}
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <circle cx="12" cy="12" r="4" />
                  </svg>
                  <span class="commit-company">{item.company}</span>
                  <span class="commit-separator">•</span>
                  <span class="commit-role">{item.position}</span>
                </div>
                <div class="commit-meta">
                  <span class="commit-date">{item.dateRange}</span>
                  <span class="commit-hash">{hash}</span>
                </div>
              </div>
              <svg
                class="commit-chevron w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>
            <div class="commit-details">
              <div class="diff-section">
                <div class="diff-header">
                  <span class="diff-file">responsibilities.diff</span>
                  <span class="diff-stats">
                    <span class="diff-additions">+{item.highlights.length}</span>
                  </span>
                </div>
                <div class="diff-content">
                  {item.highlights.map((highlight) => (
                    <div class="diff-line diff-add">
                      <span class="diff-prefix">+</span> {highlight}
                    </div>
                  ))}
                </div>
              </div>
              {item.technologies && item.technologies.length > 0 && (
                <div class="diff-section">
                  <div class="diff-header">
                    <span class="diff-file">tech-stack.json</span>
                  </div>
                  <pre class="diff-content diff-json">
                    <code>{`
{
  "technologies": [${item.technologies.map((t: string) => `"${t}"`).join(', ')}]
}`}</code>
                  </pre>
                </div>
              )}
            </div>
          </div>
        );
      })
    }
  </div>

  <!-- Timeline Footer -->
  <div class="timeline-footer">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M12 6v6l4 2"></path>
    </svg>
    <span>{footerText}</span>
  </div>
</div>
