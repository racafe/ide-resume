---
import TsxFile, { type TsxFormField } from '@components/TsxFile.astro';
import type { Resume } from '../../data/resume';

export interface Props {
  resume: Resume;
}

const { resume } = Astro.props;

// Header lines with TSX imports and component definition
const headerLines: string[] = [
  `<span class="syntax-comment">// contact.tsx - Get in Touch Component</span>`,
  `<span class="syntax-comment">// ${resume.contact.name} - ${resume.contact.title}</span>`,
  ``,
  `<span class="syntax-keyword">import</span> <span class="syntax-variable">React</span>, &#123; <span class="syntax-variable">useState</span> &#125; <span class="syntax-keyword">from</span> <span class="syntax-string">'react'</span>;`,
  ``,
  `<span class="syntax-keyword">interface</span> <span class="syntax-type">ContactFormProps</span> &#123;`,
  `  <span class="syntax-variable">recipient</span>: <span class="syntax-type">string</span>;`,
  `  <span class="syntax-variable">theme</span>?: <span class="syntax-string">'dark'</span> | <span class="syntax-string">'light'</span>;`,
  `&#125;`,
  ``,
  `<span class="syntax-keyword">export const</span> <span class="syntax-function">ContactForm</span>: <span class="syntax-type">React.FC</span>&lt;<span class="syntax-type">ContactFormProps</span>&gt; = (&#123;`,
  `  <span class="syntax-variable">recipient</span> = <span class="syntax-string">"${resume.contact.email}"</span>,`,
  `  <span class="syntax-variable">theme</span> = <span class="syntax-string">"dark"</span>`,
  `&#125;) =&gt; &#123;`,
  ``,
  `  <span class="syntax-keyword">return</span> (`,
  `    &lt;<span class="syntax-type">form</span> <span class="syntax-variable">className</span>=<span class="syntax-string">"contact-form"</span>&gt;`,
  ``,
];

// Form fields configuration
const formFields: TsxFormField[] = [
  {
    linesBefore: [
      `      &lt;<span class="syntax-type">Input</span>`,
      `        <span class="syntax-variable">type</span>=<span class="syntax-string">"text"</span>`,
      `        <span class="syntax-variable">name</span>=<span class="syntax-string">"name"</span>`,
      `        <span class="syntax-variable">label</span>=<span class="syntax-string">"Your Name"</span>`,
      `        <span class="syntax-variable">required</span>=&#123;<span class="syntax-keyword">true</span>&#125;`,
      `        <span class="syntax-variable">value</span>=&#123;`,
    ],
    inputType: 'text',
    inputId: 'contact-name',
    inputName: 'name',
    placeholder: 'string',
    required: true,
    linesAfter: [`&#125;`, `      /&gt;`],
  },
  {
    linesBefore: [
      ``,
      `      &lt;<span class="syntax-type">Input</span>`,
      `        <span class="syntax-variable">type</span>=<span class="syntax-string">"email"</span>`,
      `        <span class="syntax-variable">name</span>=<span class="syntax-string">"email"</span>`,
      `        <span class="syntax-variable">label</span>=<span class="syntax-string">"Email Address"</span>`,
      `        <span class="syntax-variable">required</span>=&#123;<span class="syntax-keyword">true</span>&#125;`,
      `        <span class="syntax-variable">value</span>=&#123;`,
    ],
    inputType: 'email',
    inputId: 'contact-email',
    inputName: 'email',
    placeholder: 'string',
    required: true,
    linesAfter: [`&#125;`, `      /&gt;`],
  },
  {
    linesBefore: [
      ``,
      `      &lt;<span class="syntax-type">TextArea</span>`,
      `        <span class="syntax-variable">name</span>=<span class="syntax-string">"message"</span>`,
      `        <span class="syntax-variable">label</span>=<span class="syntax-string">"Message"</span>`,
      `        <span class="syntax-variable">rows</span>=&#123;<span class="syntax-number">5</span>&#125;`,
      `        <span class="syntax-variable">required</span>=&#123;<span class="syntax-keyword">true</span>&#125;`,
      `        <span class="syntax-variable">value</span>=&#123;`,
    ],
    inputType: 'textarea',
    inputId: 'contact-message',
    inputName: 'message',
    placeholder: 'string',
    required: true,
    rows: 4,
    linesAfter: [`&#125;`, `      /&gt;`],
  },
];

// Submit button configuration
const submitButton = {
  linesBefore: [
    ``,
    `      &lt;<span class="syntax-type">Button</span>`,
    `        <span class="syntax-variable">type</span>=<span class="syntax-string">"submit"</span>`,
    `        <span class="syntax-variable">variant</span>=<span class="syntax-string">"primary"</span>`,
    `        <span class="syntax-variable">onClick</span>=&#123;<span class="syntax-function">handleSubmit</span>&#125;`,
    `      &gt;`,
  ],
  buttonId: 'contact-submit',
  buttonText: 'sendMessage()',
};

// Footer lines closing the component
const footerLines: string[] = [
  ``,
  `    &lt;/<span class="syntax-type">form</span>&gt;`,
  `  );`,
  `&#125;;`,
  ``,
  `<span class="syntax-keyword">export default</span> <span class="syntax-function">ContactForm</span>;`,
];

// Success state lines
const successLines: string[] = [
  `<span class="syntax-comment">// ✓ Component rendered successfully</span>`,
  `<span class="syntax-comment">// Message sent to: ${resume.contact.email}</span>`,
  ``,
  `<span class="syntax-keyword">const</span> <span class="syntax-variable">response</span>: <span class="syntax-type">ApiResponse</span> = &#123;`,
  `  <span class="syntax-variable">status</span>: <span class="syntax-number">200</span>,`,
  `  <span class="syntax-variable">message</span>: <span class="syntax-string">"Thank you! I'll get back to you soon."</span>,`,
  `  <span class="syntax-variable">timestamp</span>: <span class="syntax-keyword">new</span> <span class="syntax-type">Date</span>().<span class="syntax-function">toISOString</span>()`,
  `&#125;;`,
  ``,
  `<span class="syntax-variable">console</span>.<span class="syntax-function">log</span>(<span class="syntax-string">'✓ Email queued for delivery'</span>);`,
];
---

<TsxFile
  filename="contact.tsx"
  headerLines={headerLines}
  formFields={formFields}
  submitButton={submitButton}
  footerLines={footerLines}
  successLines={successLines}
  resetButtonId="contact-reset"
/>
