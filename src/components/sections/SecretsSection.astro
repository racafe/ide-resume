---
import TipBox from '../TipBox.astro';
import ConfigFile, { type ConfigLine } from '../ConfigFile.astro';
import MarkdownFile from '../MarkdownFile.astro';
import UnlockFile, { type Achievement } from '../UnlockFile.astro';
import LogFile, { type LogEntry } from '../LogFile.astro';
import type { Resume } from '../../data/resume';

export interface Props {
  resume: Resume;
}

const { resume } = Astro.props;

// rafael.config.js content
const configLines: ConfigLine[] = [
  { content: '// rafael.config.js - Developer Configuration', type: 'comment' },
  { content: '// WARNING: Modifying these values may cause unexpected behavior', type: 'comment' },
  { content: '', type: 'empty' },
  { content: 'module.exports = {' },
  { content: `  name: "${resume.contact.name}",` },
  { content: `  location: "${resume.contact.location.split(',')[0]}",` },
  { content: '  timezone: "Europe/Berlin",' },
  { content: '', type: 'empty' },
  { content: '  // Core Settings', type: 'comment' },
  { content: '  coffeeLevel: "critical",' },
  { content: '  caffeineThreshold: 3, // cups before functioning' },
  { content: '  preferredIDE: "VS Code", // obviously' },
  { content: '  darkMode: true, // always' },
  { content: '', type: 'empty' },
  { content: '  // Debugging Behavior', type: 'comment' },
  { content: '  debugMode: process.env.NODE_ENV === "development",' },
  { content: '  rubberDuckEnabled: true,' },
  { content: '  stackOverflowTabsOpen: 47,' },
  { content: '', type: 'empty' },
  { content: '  // Work-Life Balance', type: 'comment' },
  { content: '  workHours: {' },
  { content: '    start: "09:00",' },
  { content: '    end: "18:00",' },
  { content: '    actualEnd: "whenever the bug is fixed",' },
  { content: '  },' },
  { content: '', type: 'empty' },
  { content: '  // Error Handling', type: 'comment' },
  { content: '  onError: (err) => {' },
  { content: '    if (err.type === "MERGE_CONFLICT") {' },
  { content: '      return "git stash && cry";' },
  { content: '    }' },
  { content: '    if (err.type === "PRODUCTION_DOWN") {' },
  { content: '      return "panic().then(debug)";' },
  { content: '    }' },
  { content: `    return "console.log('This should never happen')";` },
  { content: '  },' },
  { content: '', type: 'empty' },
  { content: '  // Feature Flags', type: 'comment' },
  { content: '  features: {' },
  { content: '    optimism: true,' },
  { content: "    imposterSyndrome: true, // can't disable" },
  { content: '    perfectionism: true,' },
  { content: '    procrastination: "enabled_for_side_projects",' },
  { content: '  },' },
  { content: '', type: 'empty' },
  { content: '  // Easter Egg', type: 'comment' },
  { content: '  secretHandshake: "↑ ↑ ↓ ↓ ← → ← → B A",' },
  { content: '};' },
];

// achievements.unlock content
const achievements: Achievement[] = [
  {
    id: 'SECRET_HUNTER',
    name: 'Secret Hunter',
    description: 'Found the .secrets folder',
    status: 'UNLOCKED',
    points: 100,
  },
  {
    id: 'KONAMI_MASTER',
    name: 'Konami Master',
    description: 'Entered the legendary code',
    hint: '↑ ↑ ↓ ↓ ← → ← → B A',
    status: 'LOCKED',
    points: 500,
  },
  {
    id: 'CONFIG_READER',
    name: 'Config Reader',
    description: 'Read rafael.config.js',
    status: 'LOCKED',
    points: 50,
  },
  {
    id: 'CAREER_ARCHAEOLOGIST',
    name: 'Career Archaeologist',
    description: 'Read the career debug logs',
    status: 'LOCKED',
    points: 75,
  },
  {
    id: 'TAB_HOARDER',
    name: 'Tab Hoarder',
    description: 'Open all files at once',
    status: 'LOCKED',
    points: 150,
  },
  {
    id: 'NIGHT_OWL',
    name: 'Night Owl',
    description: 'Visit the site between 2-4 AM',
    status: 'LOCKED',
    points: 200,
  },
];

// career.log content
const careerEntries: LogEntry[] = [
  { message: '// career.log - Debug Output from Life', type: 'comment' },
  { message: '// Generated by: rafael.exe v29.0', type: 'comment' },
  { message: '', type: 'empty' },
  { year: 2004, level: 'INFO', message: 'Advanced English for Science at Boston University' },
  { year: 2005, level: 'INFO', message: 'Started Computer Engineering at Tec de Monterrey' },
  { year: 2005, level: 'DEBUG', message: 'First "Hello World" executed. Coffee dependency initialized' },
  { message: '', type: 'empty' },
  { year: 2009, level: 'INFO', message: 'Graduated Computer Engineering - Magna Cum Laude (95/100)' },
  { year: 2009, level: 'DEBUG', message: 'Outstanding grade in CENEVAL final global examination' },
  { year: 2009, level: 'INFO', message: 'Joined T-Systems Puebla - Developed PMBOK/PMI course on Moodle' },
  { message: '', type: 'empty' },
  { year: 2010, level: 'INFO', message: 'Co-founded Technit Solutions México as CTO' },
  { year: 2010, level: 'INFO', message: 'Started Master in eCommerce at Tec de Monterrey' },
  { year: 2011, level: 'INFO', message: 'Completed Master in eCommerce' },
  { year: 2011, level: 'DEBUG', message: 'First mobile app launched through Technit' },
  { message: '', type: 'empty' },
  { year: 2018, level: 'INFO', message: 'Joined Schulte & Schmidt GmbH as Solution Architect' },
  { year: 2018, level: 'DEBUG', message: 'Developed Intranet from zero (MariaDB, SQL Server, Sybase, LDAP)' },
  { year: 2019, level: 'INFO', message: 'Deployed real-time dashboards (Docker, Ruby)' },
  { year: 2020, level: 'INFO', message: 'Configured Icinga2 monitoring system' },
  { year: 2021, level: 'INFO', message: 'Developed iOS/Android apps for administration board' },
  { message: '', type: 'empty' },
  { year: 2021, level: 'INFO', message: 'Joined noris network AG as Senior Software Engineer' },
  { year: 2021, level: 'DEBUG', message: 'Location updated: Nuremberg, Germany' },
  { year: 2021, level: 'INFO', message: 'Technit: 30+ mobile apps launched milestone reached' },
  { message: '', type: 'empty' },
  { year: 2022, level: 'DEBUG', message: 'Balancing dual roles: noris network AG + Technit CTO' },
  { year: 2023, level: 'INFO', message: 'Continuing solution architecture work at Noris' },
  { year: 2024, level: 'DEBUG', message: 'Tech stack: JavaScript, TypeScript, React, Angular, Ionic, Laravel' },
  { message: '', type: 'empty' },
  { year: 2025, level: 'INFO', message: 'Technit: Ongoing mobile app development and cloud solutions' },
  { year: 2025, level: 'DEBUG', message: 'Solution architecture expertise: Monolithic & Microservices' },
  { message: '', type: 'empty' },
  { year: 2026, level: 'INFO', message: 'Building this VS Code portfolio' },
  { year: 2026, level: 'DEBUG', message: "Meta moment: you're reading logs inside a fake IDE" },
  { year: 2026, level: 'INFO', message: 'Career.status = "evolving" | Location: Nuremberg, Germany' },
  { message: '', type: 'empty' },
  { message: '// EOF - More logs coming soon...', type: 'comment' },
];
---

<!-- rafael.config.js Content - Humorous Configuration -->
<ConfigFile filename="rafael.config.js" lines={configLines} />

<!-- konami.md Content - Easter Egg Hint -->
<MarkdownFile filename="konami.md">
  <h1>You Found a Secret!</h1>

  <blockquote>
    <p>"The code is strong with this one..."</p>
  </blockquote>

  <p>
    Congratulations, curious explorer! You've discovered the hidden <code>.secrets</code> folder. Not many visitors venture
    this deep into the file tree.
  </p>

  <h2>The Konami Code</h2>

  <p>
    There's an old legend among developers. A secret combination passed down through generations of gamers and coders
    alike:
  </p>

  <pre><code>↑ ↑ ↓ ↓ ← → ← → B A</code></pre>

  <p>Some say if you enter this sequence on this very page, something magical might happen...</p>

  <TipBox variant="tip" title="Hint">
    Try using your keyboard arrow keys followed by 'B' and 'A'. Who knows what you might unlock?
  </TipBox>

  <h2>Why Easter Eggs?</h2>

  <p>
    Because coding should be fun! Hidden features and secret messages are a time-honored tradition in software
    development. They're a way for developers to add personality to their work and reward curious users who explore.
  </p>

  <p>
    <em>Keep exploring - there might be more secrets hidden in this portfolio...</em>
  </p>
</MarkdownFile>

<!-- achievements.unlock Content - Discoverable Easter Eggs List -->
<UnlockFile filename="achievements.unlock" achievements={achievements} />

<!-- career.log Content - Fun Debug Log of Career Moments -->
<LogFile filename="career.log" entries={careerEntries} />
