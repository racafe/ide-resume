---
import TypeScriptFile from '@components/TypeScriptFile.astro';
import type { TsLine } from '@components/TypeScriptFile.astro';

export interface SkillsData {
  languages: string[];
  frameworks: string[];
  databases: string[];
  os: string[];
  cloud: string[];
}

export interface Props {
  skills: SkillsData;
}

const { skills } = Astro.props;

// Build TypeScript code lines for the skills file
const lines: TsLine[] = [
  { content: '// skills.ts - Technical Skills & Expertise', type: 'comment' },
  { content: '// Last updated: 2026', type: 'comment' },
  { content: '', type: 'empty' },
  { content: 'interface Developer {' },
  { content: '  languages: string[];' },
  { content: '  frameworks: string[];' },
  { content: '  databases: string[];' },
  { content: '  os: string[];' },
  { content: '  cloud: string[];' },
  { content: '}' },
  { content: '', type: 'empty' },
  { content: 'const rafael: Developer = {' },
  { content: '  languages: [' },
  ...skills.languages.map((skill, i) => ({
    content: `    "${skill}"${i < skills.languages.length - 1 ? ',' : ''}`,
  })),
  { content: '  ],' },
  { content: '', type: 'empty' },
  { content: '  frameworks: [' },
  ...skills.frameworks.map((skill, i) => ({
    content: `    "${skill}"${i < skills.frameworks.length - 1 ? ',' : ''}`,
  })),
  { content: '  ],' },
  { content: '', type: 'empty' },
  { content: '  databases: [' },
  ...skills.databases.map((skill, i) => ({
    content: `    "${skill}"${i < skills.databases.length - 1 ? ',' : ''}`,
  })),
  { content: '  ],' },
  { content: '', type: 'empty' },
  { content: '  os: [' },
  ...skills.os.map((skill, i) => ({
    content: `    "${skill}"${i < skills.os.length - 1 ? ',' : ''}`,
  })),
  { content: '  ],' },
  { content: '', type: 'empty' },
  { content: '  cloud: [' },
  ...skills.cloud.map((skill, i) => ({
    content: `    "${skill}"${i < skills.cloud.length - 1 ? ',' : ''}`,
  })),
  { content: '  ],' },
  { content: '};' },
  { content: '', type: 'empty' },
  { content: 'export default rafael;' },
];
---

<TypeScriptFile filename="skills.ts" lines={lines} />
