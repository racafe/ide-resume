---
import JsonFile from '@components/JsonFile.astro';
import type { TimelineItem } from '@components/Timeline.astro';
import type { WorkExperience } from '../../data/resume';

export interface Props {
  workExperience: WorkExperience[];
  formatDateRange: (startDate: string, endDate: string | 'Present') => string;
}

const { workExperience, formatDateRange } = Astro.props;

// Convert WorkExperience[] to TimelineItem[] format
const timelineItems: TimelineItem[] = workExperience.map((exp, index) => ({
  id: exp.company.toLowerCase().replace(/[^a-z0-9]/g, '-'),
  company: exp.company,
  position: exp.position,
  dateRange: formatDateRange(exp.startDate, exp.endDate),
  hash: ['HEAD', 'b2c3d4e', 'c3d4e5f', 'd4e5f6a'][index],
  highlights: exp.highlights,
  technologies: exp.technologies,
}));
---

<JsonFile filename="experience.json" items={timelineItems} />
