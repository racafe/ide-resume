---
import type { WorkExperience } from '../../data/resume';

export interface Props {
  workExperience: WorkExperience[];
  formatDateRange: (startDate: string, endDate: string | 'Present') => string;
}

const { workExperience, formatDateRange } = Astro.props;
---

<div class="file-content" data-content="experience.json">
  <div class="timeline-panel max-w-4xl">
    <!-- Panel Header -->
    <div class="timeline-header">
      <div class="timeline-header-title">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M12 3v6m0 6v6"></path>
        </svg>
        <span>TIMELINE</span>
      </div>
      <span class="timeline-header-count">{workExperience.length} entries</span>
    </div>

    <!-- Timeline Entries -->
    <div class="timeline-entries">
      {
        workExperience.map((exp, index) => {
          const entryId = exp.company.toLowerCase().replace(/[^a-z0-9]/g, '-');
          const isFirst = index === 0;
          const isLast = index === workExperience.length - 1;
          const dateRange = formatDateRange(exp.startDate, exp.endDate);
          const hash = ['HEAD', 'b2c3d4e', 'c3d4e5f', 'd4e5f6a'][index] || `#${entryId}`;

          return (
            <div class="timeline-entry" data-entry={entryId} data-expanded={isFirst ? 'true' : 'false'}>
              <button class="timeline-commit" aria-expanded={isFirst ? 'true' : 'false'}>
                <div class="commit-graph">
                  <div class="commit-line" />
                  <div class="commit-dot" />
                  <div class={`commit-line-bottom ${isLast ? 'faded' : ''}`} />
                </div>
                <div class="commit-content">
                  <div class="commit-header">
                    <svg class="commit-icon w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                      <circle cx="12" cy="12" r="4" />
                    </svg>
                    <span class="commit-company">{exp.company}</span>
                    <span class="commit-separator">•</span>
                    <span class="commit-role">{exp.position}</span>
                  </div>
                  <div class="commit-meta">
                    <span class="commit-date">{dateRange}</span>
                    <span class="commit-hash">{hash}</span>
                  </div>
                </div>
                <svg
                  class="commit-chevron w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M9 18l6-6-6-6" />
                </svg>
              </button>
              <div class="commit-details">
                <div class="diff-section">
                  <div class="diff-header">
                    <span class="diff-file">responsibilities.diff</span>
                    <span class="diff-stats">
                      <span class="diff-additions">+{exp.highlights.length}</span>
                    </span>
                  </div>
                  <div class="diff-content">
                    {exp.highlights.map((highlight) => (
                      <div class="diff-line diff-add">
                        <span class="diff-prefix">+</span> {highlight}
                      </div>
                    ))}
                  </div>
                </div>
                {exp.technologies && exp.technologies.length > 0 && (
                  <div class="diff-section">
                    <div class="diff-header">
                      <span class="diff-file">tech-stack.json</span>
                    </div>
                    <pre class="diff-content diff-json">
                      <code>{`
{
  "technologies": [${exp.technologies.map((t: string) => `"${t}"`).join(', ')}]
}`}</code>
                    </pre>
                  </div>
                )}
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Timeline Footer -->
    <div class="timeline-footer">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 6v6l4 2"></path>
      </svg>
      <span>Career journey continues...</span>
    </div>
  </div>
</div>
