---
import type { Resume } from '../../data/resume';
import YamlFile, { type YamlLine } from '@components/YamlFile.astro';

export interface Props {
  resume: Resume;
  formatEducationPeriod: (graduationDate: string, degree: string) => string;
}

const { resume, formatEducationPeriod } = Astro.props;

// Build YAML lines array for the YamlFile component
const yamlLines: YamlLine[] = [
  { content: '# education.yaml - Education & Certifications', type: 'comment' },
  { content: `# ${resume.contact.name} - ${resume.contact.title}`, type: 'comment' },
  { content: '', type: 'empty' },
  { content: 'certifications', type: 'key' },
];

// Add certifications entries
resume.certifications.forEach((cert, index) => {
  yamlLines.push({ content: `- name: "${cert.name}"`, indent: 1, type: 'list-item' });
  yamlLines.push({ content: `issuer: "${cert.issuer}"`, indent: 2 });
  yamlLines.push({ content: `year: ${cert.dateObtained}`, indent: 2 });
  if (index < resume.certifications.length - 1) {
    yamlLines.push({ content: '', type: 'empty' });
  }
});

yamlLines.push({ content: '', type: 'empty' });
yamlLines.push({ content: 'education', type: 'key' });

resume.education.forEach((edu, index) => {
  const degreeDisplay =
    edu.degree === 'Master' ? `Master in ${edu.field}` : edu.degree === 'Bachelor' ? edu.field : edu.field;
  const period = formatEducationPeriod(edu.graduationDate, edu.degree);

  yamlLines.push({ content: `- degree: "${degreeDisplay}"`, indent: 1, type: 'list-item' });
  yamlLines.push({ content: `institution: "${edu.institution}"`, indent: 2 });
  yamlLines.push({ content: `location: "${edu.location}"`, indent: 2 });
  yamlLines.push({ content: `year: ${edu.graduationDate}`, indent: 2 });
  yamlLines.push({ content: `period: "${period}"`, indent: 2 });

  if (edu.gpa) {
    yamlLines.push({ content: `gpa: "${edu.gpa}"`, indent: 2 });
  }

  if (edu.honors && edu.honors.length > 0) {
    yamlLines.push({ content: 'honors', indent: 2, type: 'key' });
    edu.honors.forEach((honor) => {
      yamlLines.push({ content: `- "${honor}"`, indent: 3, type: 'list-item' });
    });
  }

  if (edu.relevantCourses && edu.relevantCourses.length > 0) {
    yamlLines.push({ content: 'specializations', indent: 2, type: 'key' });
    edu.relevantCourses.forEach((course) => {
      yamlLines.push({ content: `- "${course}"`, indent: 3, type: 'list-item' });
    });
  }

  if (edu.degree === 'Certificate') {
    yamlLines.push({ content: 'type: "Language Certificate"', indent: 2 });
  }

  if (index < resume.education.length - 1) {
    yamlLines.push({ content: '', type: 'empty' });
  }
});

yamlLines.push({ content: '', type: 'empty' });
yamlLines.push({ content: 'continuous_learning', type: 'key' });
yamlLines.push({ content: 'platforms', indent: 1, type: 'key' });
yamlLines.push({ content: '- "NOW Learning"', indent: 2, type: 'list-item' });
yamlLines.push({ content: '- "Pluralsight"', indent: 2, type: 'list-item' });
yamlLines.push({ content: '- "Udemy"', indent: 2, type: 'list-item' });
yamlLines.push({ content: '- "Frontend Masters"', indent: 2, type: 'list-item' });
yamlLines.push({ content: 'current_focus', indent: 1, type: 'key' });
yamlLines.push({ content: '- "Cloud Architecture"', indent: 2, type: 'list-item' });
yamlLines.push({ content: '- "Security Best Practices"', indent: 2, type: 'list-item' });
yamlLines.push({ content: '- "System Design"', indent: 2, type: 'list-item' });
---

<YamlFile filename="education.yaml" lines={yamlLines} />
