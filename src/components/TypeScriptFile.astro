---
export interface TsLine {
  content: string;
  type?: 'comment' | 'keyword' | 'interface' | 'property' | 'string' | 'empty' | 'code';
}

export interface Props {
  filename: string;
  lines: TsLine[];
}

const { filename, lines } = Astro.props;

// Helper function to escape HTML entities
function escapeHtml(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/{/g, '&#123;')
    .replace(/}/g, '&#125;');
}

// Format TypeScript code with syntax highlighting
function formatTsLine(line: TsLine): string {
  const content = line.content;

  switch (line.type) {
    case 'comment':
      return `<span class="syntax-comment">${escapeHtml(content)}</span>`;
    case 'empty':
      return '';
    default:
      // Auto-detect and highlight TypeScript syntax
      return highlightTypeScript(content);
  }
}

function highlightTypeScript(code: string): string {
  let result = escapeHtml(code);

  // Keywords (order matters - longer keywords first)
  const keywords = ['interface', 'export', 'default', 'import', 'const', 'from', 'type', 'let', 'var'];
  keywords.forEach((keyword) => {
    result = result.replace(new RegExp(`\\b(${keyword})\\b`, 'g'), '<span class="syntax-keyword">$1</span>');
  });

  // Types (common ones)
  const types = ['string', 'number', 'boolean', 'void', 'any', 'never', 'unknown'];
  types.forEach((type) => {
    result = result.replace(new RegExp(`:\\s*(${type})(\\[\\])?`, 'g'), ': <span class="syntax-type">$1</span>$2');
  });

  // Custom type names (PascalCase after : or <)
  result = result.replace(/:\s*([A-Z][a-zA-Z0-9]*)/g, ': <span class="syntax-type">$1</span>');

  // Strings (double and single quoted)
  result = result.replace(/(&quot;[^&]*&quot;|'[^']*')/g, '<span class="syntax-string">$1</span>');

  // Variable names in object literals
  result = result.replace(/^\s*([a-zA-Z_][a-zA-Z0-9_]*):/gm, '<span class="syntax-variable">$1</span>:');

  return result;
}

// Generate formatted code with line numbers
const formattedCode = lines
  .map((line, index) => {
    const lineNum = String(index + 1).padStart(2, ' ');
    const formattedContent = formatTsLine(line);
    return `<span class="line"><span class="line-number">${lineNum}</span>${formattedContent}</span>`;
  })
  .join('\n');
---

<div class="file-content" data-content={filename}>
  <div class="code-editor">
    <div class="code-content">
      <pre class="code-block"><code set:html={formattedCode} /></pre>
    </div>
  </div>
</div>
