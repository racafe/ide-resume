<span class="line"><span class="line-number">53</span>    <span class="syntax-string">"MongoDB"</span>,</span>
<span class="line"><span class="line-number">54</span>    <span class="syntax-string">"Redis"</span>,</span>
<span class="line"><span class="line-number">55</span>  ],</span>
<span class="line"><span class="line-number">56</span></span>
<span class="line"><span class="line-number">57</span>  <span class="syntax-variable">cloud</span>: [</span>
<span class="line"><span class="line-number">58</span>    <span class="syntax-string">"Azure"</span>,</span>
<span class="line"><span class="line-number">59</span>    <span class="syntax-string">"AWS"</span>,</span>
<span class="line"><span class="line-number">60</span>    <span class="syntax-string">"Vercel"</span>,</span>
<span class="line"><span class="line-number">61</span>  ],</span>
<span class="line"><span class="line-number">62</span>&#125;;</span>
<span class="line"><span class="line-number">63</span></span>
<span class="line"><span class="line-number">64</span><span class="syntax-keyword">export</span> <span class="syntax-keyword">default</span> <span class="syntax-variable">rafael</span>;</span></code></pre>
        </div>
      </div>
    </div>

    <!-- contact.tsx Content - Interactive Contact Form as TSX Component -->
    <div class="file-content" data-content="contact.tsx">
      <div class="code-editor contact-form-editor" id="contact-editor">
        <div class="code-content">
          <pre
            class="code-block"><code><span class="line"><span class="line-number"> 1</span><span class="syntax-comment">// contact.tsx - Get in Touch Component</span></span>
<span class="line"><span class="line-number"> 2</span><span class="syntax-comment">// Rafael Carrión - Full-Stack Developer</span></span>
<span class="line"><span class="line-number"> 3</span></span>
<span class="line"><span class="line-number"> 4</span><span class="syntax-keyword">import</span> <span class="syntax-variable">React</span>, &#123; <span class="syntax-variable">useState</span> &#125; <span class="syntax-keyword">from</span> <span class="syntax-string">'react'</span>;</span>
<span class="line"><span class="line-number"> 5</span></span>
<span class="line"><span class="line-number"> 6</span><span class="syntax-keyword">interface</span> <span class="syntax-type">ContactFormProps</span> &#123;</span>
<span class="line"><span class="line-number"> 7</span>  <span class="syntax-variable">recipient</span>: <span class="syntax-type">string</span>;</span>
<span class="line"><span class="line-number"> 8</span>  <span class="syntax-variable">theme</span>?: <span class="syntax-string">'dark'</span> | <span class="syntax-string">'light'</span>;</span>
<span class="line"><span class="line-number"> 9</span>&#125;</span>
<span class="line"><span class="line-number">10</span></span>
<span class="line"><span class="line-number">11</span><span class="syntax-keyword">export const</span> <span class="syntax-function">ContactForm</span>: <span class="syntax-type">React.FC</span>&lt;<span class="syntax-type">ContactFormProps</span>&gt; = (&#123;</span>
<span class="line"><span class="line-number">12</span>  <span class="syntax-variable">recipient</span> = <span class="syntax-string">"rafael@racafe.dev"</span>,</span>
<span class="line"><span class="line-number">13</span>  <span class="syntax-variable">theme</span> = <span class="syntax-string">"dark"</span></span>
<span class="line"><span class="line-number">14</span>&#125;) =&gt; &#123;</span>
<span class="line"><span class="line-number">15</span></span>
<span class="line"><span class="line-number">16</span>  <span class="syntax-keyword">return</span> (</span>
<span class="line"><span class="line-number">17</span>    &lt;<span class="syntax-type">form</span> <span class="syntax-variable">className</span>=<span class="syntax-string">"contact-form"</span>&gt;</span>
<span class="line"><span class="line-number">18</span></span></code></pre>
          <!-- Name Input Field -->
          <div class="tsx-form-field">
            <pre
              class="code-block"><code><span class="line"><span class="line-number">19</span>      &lt;<span class="syntax-type">Input</span></span>
<span class="line"><span class="line-number">20</span>        <span class="syntax-variable">type</span>=<span class="syntax-string">"text"</span></span>
<span class="line"><span class="line-number">21</span>        <span class="syntax-variable">name</span>=<span class="syntax-string">"name"</span></span>
