<script>
  // Language mode mapping based on file extension
  const languageModeMap: Record<string, string> = {
    md: 'Markdown',
    json: 'JSON',
    ts: 'TypeScript',
    tsx: 'TypeScript React',
    js: 'JavaScript',
    jsx: 'JavaScript React',
    yaml: 'YAML',
    yml: 'YAML',
    txt: 'Plain Text',
    html: 'HTML',
    css: 'CSS',
    astro: 'Astro',
    log: 'Log',
    unlock: 'Unlock File',
  };

  // Update status bar based on active file
  function updateStatusBar(filename: string) {
    const ext = filename.split('.').pop()?.toLowerCase() || '';
    const language = languageModeMap[ext] || 'Plain Text';

    // Update language mode
    const statusLanguage = document.getElementById('status-language');
    if (statusLanguage) {
      statusLanguage.textContent = language;
      statusLanguage.setAttribute('title', `Select Language Mode (${language})`);
    }

    // Update file type indicator
    const statusFileType = document.getElementById('status-file-type');
    const statusFileTypeText = document.getElementById('status-file-type-text');
    if (statusFileType && statusFileTypeText) {
      statusFileTypeText.textContent = language;
      statusFileType.setAttribute('title', `File type: ${language}`);
    }

    // Reset line/col for new file (would need actual editor integration for real values)
    const statusLineCol = document.getElementById('status-line-col');
    if (statusLineCol) {
      statusLineCol.textContent = 'Ln 1, Col 1';
    }
  }

  // Switch visible content based on active file
  function switchContent(filename: string) {
    // Hide all file content sections
    document.querySelectorAll('.file-content').forEach((content) => {
      content.classList.remove('active');
    });

    // Show the content for the active file
    const activeContent = document.querySelector(`[data-content="${filename}"]`);
    if (activeContent) {
      activeContent.classList.add('active');
    }
  }

  // Tab management - listen for file-open events from FileExplorer
  window.addEventListener('file-open', ((event: CustomEvent<{ filename: string }>) => {
    const { filename } = event.detail;
    const tabBar = document.getElementById('tab-bar');

    if (!tabBar) return;

    // Check if tab already exists
    const existingTab = tabBar.querySelector(`[data-file="${filename}"]`);
    if (existingTab) {
      // Activate existing tab
      tabBar.querySelectorAll('.tab').forEach((tab) => tab.classList.remove('active'));
      existingTab.classList.add('active');
      updateStatusBar(filename);
      switchContent(filename);
      return;
    }

    // Remove active class from all tabs
    tabBar.querySelectorAll('.tab').forEach((tab) => tab.classList.remove('active'));

    // Create new tab with icon based on file extension
    const newTab = document.createElement('div');
    newTab.className = 'tab active';
    newTab.setAttribute('data-file', filename);
    newTab.innerHTML = `
      ${getFileIconHTML(filename)}
      <span class="truncate">${filename}</span>
      <button class="tab-close" aria-label="Close tab">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6L18 18"></path>
        </svg>
      </button>
    `;

    // Add close button functionality
    const closeBtn = newTab.querySelector('.tab-close');
    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      newTab.remove();
      // If this was the active tab, activate the first remaining tab
      const remainingTabs = tabBar.querySelectorAll('.tab');
      if (remainingTabs.length > 0) {
        remainingTabs[0].classList.add('active');
        // Update status bar and content for newly active tab
        const activeFile = remainingTabs[0].getAttribute('data-file');
        if (activeFile) {
          updateStatusBar(activeFile);
          switchContent(activeFile);
        }
      }
    });

    // Add click to activate
    newTab.addEventListener('click', () => {
      tabBar.querySelectorAll('.tab').forEach((tab) => tab.classList.remove('active'));
      newTab.classList.add('active');
      updateStatusBar(filename);
      switchContent(filename);
    });

    tabBar.appendChild(newTab);
    updateStatusBar(filename);
    switchContent(filename);
  }) as EventListener);

  // Helper function to generate file icon HTML
  function getFileIconHTML(filename: string): string {
    const ext = filename.split('.').pop()?.toLowerCase() || '';

    const colorMap: Record<string, string> = {
      md: 'text-ide-accent',
      json: 'text-ide-warning',
      ts: 'text-ide-keyword',
      tsx: 'text-ide-type',
      js: 'text-ide-warning',
      yaml: 'text-ide-error',
      txt: 'text-ide-textMuted',
      log: 'text-ide-string',
      unlock: 'text-ide-number',
    };

    const color = colorMap[ext] || 'text-ide-text';

    // Return simplified file icon SVG
    return `<svg class="w-4 h-4 ${color}" viewBox="0 0 24 24" fill="currentColor">
      <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
      <polyline points="14 2 14 8 20 8" fill="none" stroke="currentColor" stroke-width="1"></polyline>
    </svg>`;
  }

  // Handle existing tab close buttons
  document.querySelectorAll('.tab-close').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const tab = btn.closest('.tab');
      if (tab) {
        const tabBar = tab.parentElement;
        tab.remove();
        const remainingTabs = tabBar?.querySelectorAll('.tab');
        if (remainingTabs && remainingTabs.length > 0) {
          remainingTabs[0].classList.add('active');
          // Update status bar and content for newly active tab
          const activeFile = remainingTabs[0].getAttribute('data-file');
          if (activeFile) {
            updateStatusBar(activeFile);
            switchContent(activeFile);
          }
        }
      }
    });
  });

  // Handle existing tab clicks
  document.querySelectorAll('.tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const tabBar = tab.parentElement;
      tabBar?.querySelectorAll('.tab').forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      // Update status bar and content for clicked tab
      const filename = tab.getAttribute('data-file');
      if (filename) {
        updateStatusBar(filename);
        switchContent(filename);
      }
    });
  });

  // Timeline expand/collapse functionality
  document.querySelectorAll('.timeline-entry').forEach((entry) => {
    const commitButton = entry.querySelector('.timeline-commit');

    commitButton?.addEventListener('click', () => {
      const isExpanded = entry.getAttribute('data-expanded') === 'true';
      entry.setAttribute('data-expanded', String(!isExpanded));
      commitButton.setAttribute('aria-expanded', String(!isExpanded));
    });
  });

  // Contact Form Validation and Submission
  const contactForm = document.getElementById('contact-editor');
  const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
  const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
  const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const successDiv = document.getElementById('contact-success');
  const resetBtn = document.getElementById('contact-reset');
  const codeContent = contactForm?.querySelector('.code-content');

  const nameError = document.getElementById('name-error');
  const emailError = document.getElementById('email-error');
  const messageError = document.getElementById('message-error');

  // TypeScript-style validation messages
  function validateName(value: string): string | null {
    if (!value.trim()) {
      return "Argument of type 'undefined' is not assignable to parameter of type 'string'";
    }
    if (value.trim().length < 2) {
      return "Property 'name' must have at least 2 characters";
    }
    return null;
  }

  function validateEmail(value: string): string | null {
    if (!value.trim()) {
      return "Argument of type 'undefined' is not assignable to parameter of type 'string'";
    }
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(value)) {
      return "Type 'string' is not assignable to type 'Email'";
    }
    return null;
  }

  function validateMessage(value: string): string | null {
    if (!value.trim()) {
      return "Argument of type 'undefined' is not assignable to parameter of type 'string'";
    }
    if (value.trim().length < 10) {
      return "Property 'message' must have at least 10 characters";
    }
    return null;
  }

  function showError(
    element: HTMLElement | null,
    input: HTMLInputElement | HTMLTextAreaElement | null,
    message: string | null
  ) {
    if (element && input) {
      element.textContent = message || '';
      if (message) {
        input.classList.add('error');
      } else {
        input.classList.remove('error');
      }
    }
  }

  // Real-time validation on blur
  nameInput?.addEventListener('blur', () => {
    showError(nameError ?? null, nameInput, validateName(nameInput.value));
  });

  emailInput?.addEventListener('blur', () => {
    showError(emailError ?? null, emailInput, validateEmail(emailInput.value));
  });

  messageInput?.addEventListener('blur', () => {
    showError(messageError ?? null, messageInput, validateMessage(messageInput.value));
  });

  // Clear error on input
  nameInput?.addEventListener('input', () => {
    if (nameInput.classList.contains('error')) {
      showError(nameError ?? null, nameInput, validateName(nameInput.value));
    }
  });

  emailInput?.addEventListener('input', () => {
    if (emailInput.classList.contains('error')) {
      showError(emailError ?? null, emailInput, validateEmail(emailInput.value));
    }
  });

  messageInput?.addEventListener('input', () => {
    if (messageInput.classList.contains('error')) {
      showError(messageError ?? null, messageInput, validateMessage(messageInput.value));
    }
  });

  // Form submission
  submitBtn?.addEventListener('click', (e) => {
    e.preventDefault();

    // Validate all fields
    const nameErr = validateName(nameInput?.value || '');
    const emailErr = validateEmail(emailInput?.value || '');
    const messageErr = validateMessage(messageInput?.value || '');

    showError(nameError ?? null, nameInput, nameErr);
    showError(emailError ?? null, emailInput, emailErr);
    showError(messageError ?? null, messageInput, messageErr);

    if (nameErr || emailErr || messageErr) {
      return;
    }

    // Show loading state
    const btnText = submitBtn.querySelector('.btn-text');
    const btnLoading = submitBtn.querySelector('.btn-loading');
    if (btnText) btnText.classList.add('hidden');
    if (btnLoading) btnLoading.classList.remove('hidden');
    submitBtn.disabled = true;

    // Simulate form submission
    setTimeout(() => {
      // Hide form, show success
      if (codeContent) codeContent.classList.add('hidden');
      if (successDiv) successDiv.classList.remove('hidden');

      // Reset button state
      if (btnText) btnText.classList.remove('hidden');
      if (btnLoading) btnLoading.classList.add('hidden');
      submitBtn.disabled = false;
    }, 1500);
  });

  // Reset form
  resetBtn?.addEventListener('click', () => {
    if (codeContent) codeContent.classList.remove('hidden');
    if (successDiv) successDiv.classList.add('hidden');

    // Clear form fields
    if (nameInput) nameInput.value = '';
    if (emailInput) emailInput.value = '';
    if (messageInput) messageInput.value = '';

    // Clear errors
    showError(nameError ?? null, nameInput, null);
    showError(emailError ?? null, emailInput, null);
    showError(messageError ?? null, messageInput, null);
  });

  // ========================================
  // KONAMI CODE EASTER EGG - SNAKE GAME
  // ========================================

  // Konami Code sequence: Up Up Down Down Left Right Left Right B A
  const konamiCode = [
    'ArrowUp',
    'ArrowUp',
    'ArrowDown',
    'ArrowDown',
    'ArrowLeft',
    'ArrowRight',
    'ArrowLeft',
    'ArrowRight',
    'KeyB',
    'KeyA',
  ];
  let konamiIndex = 0;

  // Game state
  const gameModal = document.getElementById('game-modal');
  const gameCanvas = document.getElementById('game-canvas') as HTMLCanvasElement | null;
  const gameOverlay = document.getElementById('game-overlay');
  const gameMessage = document.getElementById('game-message');
  const gameScoreEl = document.getElementById('game-score');
  const gameHighScoreEl = document.getElementById('game-high-score');
  const gameCloseBtn = document.getElementById('game-close');
  const gameBackdrop = gameModal?.querySelector('.game-modal-backdrop');

  let gameRunning = false;
  let gameLoop: number | null = null;
  let snake: { x: number; y: number }[] = [];
  let food: { x: number; y: number } = { x: 0, y: 0 };
  let direction: { x: number; y: number } = { x: 1, y: 0 };
  let nextDirection: { x: number; y: number } = { x: 1, y: 0 };
  let score = 0;
  let highScore = parseInt(localStorage.getItem('snakeHighScore') || '0', 10);

  const gridSize = 20;
  const tileCount = 20;

  // Update high score display on load
  if (gameHighScoreEl) {
    gameHighScoreEl.textContent = String(highScore);
  }

  // Konami code detection
  document.addEventListener('keydown', (e) => {
    // Don't trigger if typing in an input
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) {
      return;
    }

    if (e.code === konamiCode[konamiIndex]) {
      konamiIndex++;
      if (konamiIndex === konamiCode.length) {
        konamiIndex = 0;
        openGame();
      }
    } else {
      konamiIndex = 0;
    }
  });

  function openGame() {
    gameModal?.classList.remove('hidden');
    document.body.classList.add('game-modal-open');
    resetGame();
  }

  function closeGame() {
    gameModal?.classList.add('hidden');
    document.body.classList.remove('game-modal-open');
    if (gameLoop !== null) {
      cancelAnimationFrame(gameLoop);
      gameLoop = null;
    }
    gameRunning = false;
  }

  function resetGame() {
    snake = [{ x: 10, y: 10 }];
    direction = { x: 1, y: 0 };
    nextDirection = { x: 1, y: 0 };
    score = 0;
    if (gameScoreEl) gameScoreEl.textContent = '0';
    spawnFood();
    gameOverlay?.classList.remove('hidden');
    if (gameMessage) gameMessage.textContent = 'Press SPACE to start';
    gameRunning = false;
    if (gameLoop !== null) {
      cancelAnimationFrame(gameLoop);
      gameLoop = null;
    }
    drawGame();
  }

  function spawnFood() {
    let validPosition = false;
    while (!validPosition) {
      food = {
        x: Math.floor(Math.random() * tileCount),
        y: Math.floor(Math.random() * tileCount),
      };
      validPosition = !snake.some((segment) => segment.x === food.x && segment.y === food.y);
    }
  }

  function drawGame() {
    if (!gameCanvas) return;
    const ctx = gameCanvas.getContext('2d');
    if (!ctx) return;

    // Clear canvas with dark background
    ctx.fillStyle = '#1e1e1e';
    ctx.fillRect(0, 0, gameCanvas.width, gameCanvas.height);

    // Draw grid lines (subtle)
    ctx.strokeStyle = '#2d2d2d';
    ctx.lineWidth = 1;
    for (let i = 0; i <= tileCount; i++) {
      ctx.beginPath();
      ctx.moveTo(i * gridSize, 0);
      ctx.lineTo(i * gridSize, gameCanvas.height);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(0, i * gridSize);
      ctx.lineTo(gameCanvas.width, i * gridSize);
      ctx.stroke();
    }

    // Draw food (VS Code accent color)
    ctx.fillStyle = '#ce9178'; // ide-string color
    ctx.beginPath();
    ctx.arc(food.x * gridSize + gridSize / 2, food.y * gridSize + gridSize / 2, gridSize / 2 - 2, 0, Math.PI * 2);
    ctx.fill();

    // Draw snake
    snake.forEach((segment, index) => {
      // Head is brighter
      if (index === 0) {
        ctx.fillStyle = '#4ec9b0'; // ide-type/success color
      } else {
        ctx.fillStyle = '#007acc'; // ide-accent color
      }
      ctx.fillRect(segment.x * gridSize + 1, segment.y * gridSize + 1, gridSize - 2, gridSize - 2);
    });
  }

  function updateGame() {
    if (!gameRunning) return;

    // Apply next direction
    direction = nextDirection;

    // Move snake
    const head = { x: snake[0].x + direction.x, y: snake[0].y + direction.y };

    // Check wall collision
    if (head.x < 0 || head.x >= tileCount || head.y < 0 || head.y >= tileCount) {
      gameOver();
      return;
    }

    // Check self collision
    if (snake.some((segment) => segment.x === head.x && segment.y === head.y)) {
      gameOver();
      return;
    }

    snake.unshift(head);

    // Check food collision
    if (head.x === food.x && head.y === food.y) {
      score += 10;
      if (gameScoreEl) gameScoreEl.textContent = String(score);
      if (score > highScore) {
        highScore = score;
        localStorage.setItem('snakeHighScore', String(highScore));
        if (gameHighScoreEl) gameHighScoreEl.textContent = String(highScore);
      }
      spawnFood();
    } else {
      snake.pop();
    }

    drawGame();
  }

  function gameOver() {
    gameRunning = false;
    if (gameLoop !== null) {
      cancelAnimationFrame(gameLoop);
      gameLoop = null;
    }
    gameOverlay?.classList.remove('hidden');
    if (gameMessage) {
      gameMessage.innerHTML = `Game Over!<br><span class="syntax-comment">Score: ${score}</span><br><span class="text-ide-textMuted text-sm">Press SPACE to retry</span>`;
    }
  }

  let lastTime = 0;
  const gameSpeed = 100; // ms per frame

  function gameStep(timestamp: number) {
    if (!gameRunning) return;

    if (timestamp - lastTime >= gameSpeed) {
      lastTime = timestamp;
      updateGame();
    }

    gameLoop = requestAnimationFrame(gameStep);
  }

  function startGame() {
    if (gameRunning) return;
    gameRunning = true;
    gameOverlay?.classList.add('hidden');
    lastTime = performance.now();
    gameLoop = requestAnimationFrame(gameStep);
  }

  // Game controls
  document.addEventListener('keydown', (e) => {
    if (!gameModal || gameModal.classList.contains('hidden')) return;

    // ESC to close
    if (e.key === 'Escape') {
      closeGame();
      return;
    }

    // SPACE to start/restart
    if (e.code === 'Space') {
      e.preventDefault();
      if (!gameRunning) {
        if (snake.length === 1 || !gameOverlay?.classList.contains('hidden')) {
          resetGame();
          startGame();
        }
      }
      return;
    }

    // Arrow keys for direction (prevent scrolling while game is open)
    if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {
      e.preventDefault();

      if (!gameRunning) return;

      switch (e.key) {
        case 'ArrowUp':
          if (direction.y !== 1) nextDirection = { x: 0, y: -1 };
          break;
        case 'ArrowDown':
          if (direction.y !== -1) nextDirection = { x: 0, y: 1 };
          break;
        case 'ArrowLeft':
          if (direction.x !== 1) nextDirection = { x: -1, y: 0 };
          break;
        case 'ArrowRight':
          if (direction.x !== -1) nextDirection = { x: 1, y: 0 };
          break;
      }
    }
  });

  // Close button and backdrop click
  gameCloseBtn?.addEventListener('click', closeGame);
  gameBackdrop?.addEventListener('click', closeGame);
</script>
