---
import IDELayout from '@layouts/IDELayout.astro';
import FileExplorer from '@components/FileExplorer.astro';
import FileIcon from '@components/FileIcon.astro';
import '@styles/global.css';
---

<IDELayout title="Rafael Carrión - IDE Resume">
  <!-- Sidebar: File Explorer -->
  <Fragment slot="sidebar">
    <FileExplorer />
  </Fragment>

  <!-- Tabs -->
  <Fragment slot="tabs">
    <div class="tab active" data-file="README.md">
      <FileIcon filename="README.md" />
      <span class="truncate">README.md</span>
      <button class="tab-close" aria-label="Close tab">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6L18 18"></path>
        </svg>
      </button>
    </div>
  </Fragment>

  <!-- Editor Content: README.md -->
  <div class="markdown-preview max-w-4xl">
    <h1>Welcome to racafe.dev</h1>

    <p>
      Hello! I'm <strong>Rafael Carrión</strong>, a Full-Stack Developer based in Barcelona. This portfolio is designed
      to look and feel like <a href="https://code.visualstudio.com/">VS Code</a> — because if you're going to read about a
      developer, why not do it in their natural habitat?
    </p>

    <h2>Quick Start</h2>

    <p>Navigate through the <strong>file explorer</strong> on the left to discover different sections:</p>

    <ul>
      <li><code>README.md</code> — You are here</li>
      <li><code>about.md</code> — Learn more about me</li>
      <li><code>experience.json</code> — My professional journey</li>
      <li><code>skills.ts</code> — Technical toolkit</li>
      <li><code>education.yaml</code> — Education & certifications</li>
      <li><code>contact.tsx</code> — Let's connect</li>
    </ul>

    <h2>Features</h2>

    <p>This interactive portfolio includes:</p>

    <ul>
      <li><strong>File Explorer</strong> — Click files to open them as tabs</li>
      <li><strong>Tab System</strong> — Multiple files open at once, just like a real IDE</li>
      <li><strong>Dark+ Theme</strong> — The classic VS Code look</li>
      <li><strong>Syntax Highlighting</strong> — Code displayed with proper colors</li>
    </ul>

    <h2>About This Project</h2>

    <p>
      Built with <a href="https://astro.build/">Astro</a> and styled with
      <a href="https://tailwindcss.com/">Tailwind CSS</a>. The design faithfully recreates VS Code's Dark+ theme with
      attention to the small details: the activity bar icons, the file tree animations, and the status bar at the
      bottom.
    </p>

    <blockquote>
      <p>"Any sufficiently advanced portfolio is indistinguishable from an actual IDE."</p>
    </blockquote>

    <div class="tip-box">
      <div class="tip-box-title">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z">
          </path>
        </svg>
        Tip
      </div>
      <div class="tip-box-content">
        Use the file explorer on the left to navigate, or click on any tab to switch between open files.
      </div>
    </div>
  </div>
</IDELayout>

<script>
  // Tab management - listen for file-open events from FileExplorer
  window.addEventListener('file-open', ((event: CustomEvent<{ filename: string }>) => {
    const { filename } = event.detail;
    const tabBar = document.getElementById('tab-bar');

    if (!tabBar) return;

    // Check if tab already exists
    const existingTab = tabBar.querySelector(`[data-file="${filename}"]`);
    if (existingTab) {
      // Activate existing tab
      tabBar.querySelectorAll('.tab').forEach((tab) => tab.classList.remove('active'));
      existingTab.classList.add('active');
      return;
    }

    // Remove active class from all tabs
    tabBar.querySelectorAll('.tab').forEach((tab) => tab.classList.remove('active'));

    // Create new tab with icon based on file extension
    const newTab = document.createElement('div');
    newTab.className = 'tab active';
    newTab.setAttribute('data-file', filename);
    newTab.innerHTML = `
      ${getFileIconHTML(filename)}
      <span class="truncate">${filename}</span>
      <button class="tab-close" aria-label="Close tab">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6L18 18"></path>
        </svg>
      </button>
    `;

    // Add close button functionality
    const closeBtn = newTab.querySelector('.tab-close');
    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      newTab.remove();
      // If this was the active tab, activate the first remaining tab
      const remainingTabs = tabBar.querySelectorAll('.tab');
      if (remainingTabs.length > 0) {
        remainingTabs[0].classList.add('active');
      }
    });

    // Add click to activate
    newTab.addEventListener('click', () => {
      tabBar.querySelectorAll('.tab').forEach((tab) => tab.classList.remove('active'));
      newTab.classList.add('active');
    });

    tabBar.appendChild(newTab);
  }) as EventListener);

  // Helper function to generate file icon HTML
  function getFileIconHTML(filename: string): string {
    const ext = filename.split('.').pop()?.toLowerCase() || '';

    const colorMap: Record<string, string> = {
      md: 'text-ide-accent',
      json: 'text-ide-warning',
      ts: 'text-ide-keyword',
      tsx: 'text-ide-type',
      js: 'text-ide-warning',
      yaml: 'text-ide-error',
      txt: 'text-ide-textMuted',
    };

    const color = colorMap[ext] || 'text-ide-text';

    // Return simplified file icon SVG
    return `<svg class="w-4 h-4 ${color}" viewBox="0 0 24 24" fill="currentColor">
      <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
      <polyline points="14 2 14 8 20 8" fill="none" stroke="currentColor" stroke-width="1"></polyline>
    </svg>`;
  }

  // Handle existing tab close buttons
  document.querySelectorAll('.tab-close').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const tab = btn.closest('.tab');
      if (tab) {
        const tabBar = tab.parentElement;
        tab.remove();
        const remainingTabs = tabBar?.querySelectorAll('.tab');
        if (remainingTabs && remainingTabs.length > 0) {
          remainingTabs[0].classList.add('active');
        }
      }
    });
  });

  // Handle existing tab clicks
  document.querySelectorAll('.tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const tabBar = tab.parentElement;
      tabBar?.querySelectorAll('.tab').forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
    });
  });
</script>
