---
import IDELayout from '@layouts/IDELayout.astro';
import FileExplorer from '@components/FileExplorer.astro';
import FileIcon from '@components/FileIcon.astro';
import '@styles/global.css';
---

<IDELayout title="Rafael Carrión - IDE Resume">
  <!-- Sidebar: File Explorer -->
  <Fragment slot="sidebar">
    <FileExplorer />
  </Fragment>

  <!-- Tabs -->
  <Fragment slot="tabs">
    <div class="tab active" data-file="README.md">
      <FileIcon filename="README.md" />
      <span class="truncate">README.md</span>
      <button class="tab-close" aria-label="Close tab">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6L18 18"></path>
        </svg>
      </button>
    </div>
  </Fragment>

  <!-- Editor Content Area -->
  <div class="editor-content-area">
    <!-- README.md Content -->
    <div class="file-content active" data-content="README.md">
      <div class="markdown-preview max-w-4xl">
        <h1>Welcome to racafe.dev</h1>

        <p>
          Hello! I'm <strong>Rafael Carrión</strong>, a Full-Stack Developer based in Barcelona. This portfolio is
          designed to look and feel like <a href="https://code.visualstudio.com/">VS Code</a> — because if you're going to
          read about a developer, why not do it in their natural habitat?
        </p>

        <h2>Quick Start</h2>

        <p>Navigate through the <strong>file explorer</strong> on the left to discover different sections:</p>

        <ul>
          <li><code>README.md</code> — You are here</li>
          <li><code>about.md</code> — Learn more about me</li>
          <li><code>experience.json</code> — My professional journey</li>
          <li><code>skills.ts</code> — Technical toolkit</li>
          <li><code>education.yaml</code> — Education & certifications</li>
          <li><code>contact.tsx</code> — Let's connect</li>
        </ul>

        <h2>Features</h2>

        <p>This interactive portfolio includes:</p>

        <ul>
          <li><strong>File Explorer</strong> — Click files to open them as tabs</li>
          <li><strong>Tab System</strong> — Multiple files open at once, just like a real IDE</li>
          <li><strong>Dark+ Theme</strong> — The classic VS Code look</li>
          <li><strong>Syntax Highlighting</strong> — Code displayed with proper colors</li>
        </ul>

        <h2>About This Project</h2>

        <p>
          Built with <a href="https://astro.build/">Astro</a> and styled with
          <a href="https://tailwindcss.com/">Tailwind CSS</a>. The design faithfully recreates VS Code's Dark+ theme
          with attention to the small details: the activity bar icons, the file tree animations, and the status bar at
          the bottom.
        </p>

        <blockquote>
          <p>"Any sufficiently advanced portfolio is indistinguishable from an actual IDE."</p>
        </blockquote>

        <div class="tip-box">
          <div class="tip-box-title">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
              >
              </path>
            </svg>
            Tip
          </div>
          <div class="tip-box-content">
            Use the file explorer on the left to navigate, or click on any tab to switch between open files.
          </div>
        </div>
      </div>
    </div>

    <!-- about.md Content -->
    <div class="file-content" data-content="about.md">
      <div class="markdown-preview max-w-4xl">
        <h1>About Me</h1>

        <p>
          Hi there! I'm <strong>Rafael Carrión</strong>, a <strong>Full-Stack Developer</strong> based in
          <strong>Barcelona, Spain</strong>. I'm currently working at
          <a href="https://funditec.es" target="_blank" rel="noopener noreferrer">Funditec</a>, where I build web
          applications and solve interesting technical challenges every day.
        </p>

        <h2>What I Do</h2>

        <p>
          I specialize in building modern web applications from the ground up. My work spans the entire stack — from
          crafting intuitive user interfaces to designing robust backend systems and everything in between.
        </p>

        <ul>
          <li><strong>Frontend:</strong> React, Vue.js, TypeScript, Tailwind CSS</li>
          <li><strong>Backend:</strong> Node.js, Python, REST APIs, GraphQL</li>
          <li><strong>Database:</strong> PostgreSQL, MongoDB, Redis</li>
          <li><strong>DevOps:</strong> Docker, CI/CD, Cloud Services</li>
        </ul>

        <h2>My Approach</h2>

        <p>
          I believe in writing clean, maintainable code that solves real problems. I'm passionate about developer
          experience, performance optimization, and creating software that people actually enjoy using.
        </p>

        <blockquote>
          <p>"The best code is no code at all. The second best is code that's easy to understand and change."</p>
        </blockquote>

        <h2>Beyond the Code</h2>

        <p>
          When I'm not coding, you'll find me exploring Barcelona's coffee shops, contributing to open-source projects,
          or tinkering with side projects that may or may not see the light of day.
        </p>

        <h2>Let's Connect</h2>

        <p>I'm always open to interesting conversations and new opportunities. Find me on:</p>

        <ul>
          <li>
            <a href="https://github.com/racafe" target="_blank" rel="noopener noreferrer">GitHub</a> — Check out my open-source
            work
          </li>
          <li>
            <a href="https://linkedin.com/in/rafaelcarrion" target="_blank" rel="noopener noreferrer">LinkedIn</a> — Professional
            network
          </li>
          <li>
            <a href="https://twitter.com/racafe_dev" target="_blank" rel="noopener noreferrer">Twitter/X</a> — Occasional
            tech thoughts
          </li>
        </ul>

        <div class="tip-box">
          <div class="tip-box-title">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
              >
              </path>
            </svg>
            Get in Touch
          </div>
          <div class="tip-box-content">
            Want to work together or just say hi? Check out <code>contact.tsx</code> in the file explorer for my contact form.
          </div>
        </div>
      </div>
    </div>

    <!-- experience.json Content - Source Control/Timeline Panel -->
    <div class="file-content" data-content="experience.json">
      <div class="timeline-panel max-w-4xl">
        <!-- Panel Header -->
        <div class="timeline-header">
          <div class="timeline-header-title">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M12 3v6m0 6v6"></path>
            </svg>
            <span>TIMELINE</span>
          </div>
          <span class="timeline-header-count">2 entries</span>
        </div>

        <!-- Timeline Entries -->
        <div class="timeline-entries">
          <!-- Funditec Entry -->
          <div class="timeline-entry" data-entry="funditec">
            <button class="timeline-commit" aria-expanded="false">
              <div class="commit-graph">
                <div class="commit-line"></div>
                <div class="commit-dot"></div>
                <div class="commit-line-bottom"></div>
              </div>
              <div class="commit-content">
                <div class="commit-header">
                  <svg class="commit-icon w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <circle cx="12" cy="12" r="4"></circle>
                  </svg>
                  <span class="commit-company">Funditec</span>
                  <span class="commit-separator">•</span>
                  <span class="commit-role">Full-Stack Developer</span>
                </div>
                <div class="commit-meta">
                  <span class="commit-date">Feb 2023 - Present</span>
                  <span class="commit-hash">#HEAD</span>
                </div>
              </div>
              <svg
                class="commit-chevron w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M9 18l6-6-6-6"></path>
              </svg>
            </button>
            <div class="commit-details">
              <div class="diff-section">
                <div class="diff-header">
                  <span class="diff-file">responsibilities.diff</span>
                  <span class="diff-stats">
                    <span class="diff-additions">+8</span>
                  </span>
                </div>
                <div class="diff-content">
                  <div class="diff-line diff-add">
                    <span class="diff-prefix">+</span> Developing and maintaining web applications using React, Node.js, and
                    TypeScript
                  </div>
                  <div class="diff-line diff-add">
                    <span class="diff-prefix">+</span> Building RESTful APIs and microservices architecture
                  </div>
                  <div class="diff-line diff-add">
                    <span class="diff-prefix">+</span> Implementing CI/CD pipelines and DevOps practices
                  </div>
                  <div class="diff-line diff-add">
                    <span class="diff-prefix">+</span> Collaborating with cross-functional teams on product features
                  </div>
                  <div class="diff-line diff-add">
                    <span class="diff-prefix">+</span> Code reviews and mentoring junior developers
                  </div>
                  <div class="diff-line diff-add">
                    <span class="diff-prefix">+</span> Database design and optimization (PostgreSQL, MongoDB)
                  </div>
                  <div class="diff-line diff-add">
                    <span class="diff-prefix">+</span> Performance optimization and technical debt reduction
                  </div>
                  <div class="diff-line diff-add">
                    <span class="diff-prefix">+</span> Participating in agile ceremonies and sprint planning
                  </div>
                </div>
              </div>
              <div class="diff-section">
                <div class="diff-header">
                  <span class="diff-file">tech-stack.json</span>
                </div>
                <pre
                  class="diff-content diff-json"><code><span class="syntax-punctuation">&#123;</span>
  <span class="syntax-property">"frontend"</span><span class="syntax-punctuation">:</span> <span class="syntax-bracket">[</span><span class="syntax-string">"React"</span><span class="syntax-punctuation">,</span> <span class="syntax-string">"TypeScript"</span><span class="syntax-punctuation">,</span> <span class="syntax-string">"Tailwind"</span><span class="syntax-bracket">]</span><span class="syntax-punctuation">,</span>
  <span class="syntax-property">"backend"</span><span class="syntax-punctuation">:</span> <span class="syntax-bracket">[</span><span class="syntax-string">"Node.js"</span><span class="syntax-punctuation">,</span> <span class="syntax-string">"Express"</span><span class="syntax-punctuation">,</span> <span class="syntax-string">"Python"</span><span class="syntax-bracket">]</span><span class="syntax-punctuation">,</span>
  <span class="syntax-property">"database"</span><span class="syntax-punctuation">:</span> <span class="syntax-bracket">[</span><span class="syntax-string">"PostgreSQL"</span><span class="syntax-punctuation">,</span> <span class="syntax-string">"MongoDB"</span><span class="syntax-punctuation">,</span> <span class="syntax-string">"Redis"</span><span class="syntax-bracket">]</span><span class="syntax-punctuation">,</span>
  <span class="syntax-property">"devops"</span><span class="syntax-punctuation">:</span> <span class="syntax-bracket">[</span><span class="syntax-string">"Docker"</span><span class="syntax-punctuation">,</span> <span class="syntax-string">"GitHub Actions"</span><span class="syntax-punctuation">,</span> <span class="syntax-string">"AWS"</span><span class="syntax-bracket">]</span>
<span class="syntax-punctuation">&#125;</span></code></pre>
              </div>
            </div>
          </div>

          <!-- Cruz Roja Entry -->
          <div class="timeline-entry" data-entry="cruzroja">
            <button class="timeline-commit" aria-expanded="false">
              <div class="commit-graph">
                <div class="commit-line"></div>
                <div class="commit-dot volunteer"></div>
                <div class="commit-line-bottom faded"></div>
              </div>
              <div class="commit-content">
                <div class="commit-header">
                  <svg class="commit-icon volunteer w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path
                      d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                    >
                    </path>
                  </svg>
                  <span class="commit-company">Cruz Roja Española</span>
                  <span class="commit-separator">•</span>
                  <span class="commit-role">Technology Volunteer</span>
                </div>
                <div class="commit-meta">
                  <span class="commit-date">Sep 2021 - Jan 2023</span>
                  <span class="commit-hash">#a1b2c3d</span>
                </div>
              </div>
              <svg
                class="commit-chevron w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M9 18l6-6-6-6"></path>
              </svg>
            </button>
            <div class="commit-details">
              <div class="diff-section">
                <div class="diff-header">
                  <span class="diff-file">contributions.diff</span>
                  <span class="diff-stats">
                    <span class="diff-additions">+5</span>
                  </span>
                </div>
                <div class="diff-content">
                  <div class="diff-line diff-add">
                    <span class="diff-prefix">+</span> Developed internal tools to streamline volunteer coordination
                  </div>
                  <div class="diff-line diff-add">
                    <span class="diff-prefix">+</span> Built data visualization dashboards for humanitarian aid tracking
                  </div>
                  <div class="diff-line diff-add">
                    <span class="diff-prefix">+</span> Provided technical support and training to staff members
                  </div>
                  <div class="diff-line diff-add">
                    <span class="diff-prefix">+</span> Maintained and improved legacy systems
                  </div>
                  <div class="diff-line diff-add">
                    <span class="diff-prefix">+</span> Collaborated on digital transformation initiatives
                  </div>
                </div>
              </div>
              <div class="diff-section">
                <div class="diff-header">
                  <span class="diff-file">impact.json</span>
                </div>
                <pre
                  class="diff-content diff-json"><code><span class="syntax-punctuation">&#123;</span>
  <span class="syntax-property">"type"</span><span class="syntax-punctuation">:</span> <span class="syntax-string">"volunteer"</span><span class="syntax-punctuation">,</span>
  <span class="syntax-property">"focus"</span><span class="syntax-punctuation">:</span> <span class="syntax-string">"technology &amp; digital transformation"</span><span class="syntax-punctuation">,</span>
  <span class="syntax-property">"learning"</span><span class="syntax-punctuation">:</span> <span class="syntax-string">"nonprofit tech challenges &amp; social impact"</span>
<span class="syntax-punctuation">&#125;</span></code></pre>
              </div>
            </div>
          </div>
        </div>

        <!-- Timeline Footer -->
        <div class="timeline-footer">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 6v6l4 2"></path>
          </svg>
          <span>Career journey continues...</span>
        </div>
      </div>
    </div>
  </div>
</IDELayout>

<script>
  // Language mode mapping based on file extension
  const languageModeMap: Record<string, string> = {
    md: 'Markdown',
    json: 'JSON',
    ts: 'TypeScript',
    tsx: 'TypeScript React',
    js: 'JavaScript',
    jsx: 'JavaScript React',
    yaml: 'YAML',
    yml: 'YAML',
    txt: 'Plain Text',
    html: 'HTML',
    css: 'CSS',
    astro: 'Astro',
  };

  // Update status bar based on active file
  function updateStatusBar(filename: string) {
    const ext = filename.split('.').pop()?.toLowerCase() || '';
    const language = languageModeMap[ext] || 'Plain Text';

    // Update language mode
    const statusLanguage = document.getElementById('status-language');
    if (statusLanguage) {
      statusLanguage.textContent = language;
      statusLanguage.setAttribute('title', `Select Language Mode (${language})`);
    }

    // Update file type indicator
    const statusFileType = document.getElementById('status-file-type');
    const statusFileTypeText = document.getElementById('status-file-type-text');
    if (statusFileType && statusFileTypeText) {
      statusFileTypeText.textContent = language;
      statusFileType.setAttribute('title', `File type: ${language}`);
    }

    // Reset line/col for new file (would need actual editor integration for real values)
    const statusLineCol = document.getElementById('status-line-col');
    if (statusLineCol) {
      statusLineCol.textContent = 'Ln 1, Col 1';
    }
  }

  // Switch visible content based on active file
  function switchContent(filename: string) {
    // Hide all file content sections
    document.querySelectorAll('.file-content').forEach((content) => {
      content.classList.remove('active');
    });

    // Show the content for the active file
    const activeContent = document.querySelector(`[data-content="${filename}"]`);
    if (activeContent) {
      activeContent.classList.add('active');
    }
  }

  // Tab management - listen for file-open events from FileExplorer
  window.addEventListener('file-open', ((event: CustomEvent<{ filename: string }>) => {
    const { filename } = event.detail;
    const tabBar = document.getElementById('tab-bar');

    if (!tabBar) return;

    // Check if tab already exists
    const existingTab = tabBar.querySelector(`[data-file="${filename}"]`);
    if (existingTab) {
      // Activate existing tab
      tabBar.querySelectorAll('.tab').forEach((tab) => tab.classList.remove('active'));
      existingTab.classList.add('active');
      updateStatusBar(filename);
      switchContent(filename);
      return;
    }

    // Remove active class from all tabs
    tabBar.querySelectorAll('.tab').forEach((tab) => tab.classList.remove('active'));

    // Create new tab with icon based on file extension
    const newTab = document.createElement('div');
    newTab.className = 'tab active';
    newTab.setAttribute('data-file', filename);
    newTab.innerHTML = `
      ${getFileIconHTML(filename)}
      <span class="truncate">${filename}</span>
      <button class="tab-close" aria-label="Close tab">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6L18 18"></path>
        </svg>
      </button>
    `;

    // Add close button functionality
    const closeBtn = newTab.querySelector('.tab-close');
    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      newTab.remove();
      // If this was the active tab, activate the first remaining tab
      const remainingTabs = tabBar.querySelectorAll('.tab');
      if (remainingTabs.length > 0) {
        remainingTabs[0].classList.add('active');
        // Update status bar and content for newly active tab
        const activeFile = remainingTabs[0].getAttribute('data-file');
        if (activeFile) {
          updateStatusBar(activeFile);
          switchContent(activeFile);
        }
      }
    });

    // Add click to activate
    newTab.addEventListener('click', () => {
      tabBar.querySelectorAll('.tab').forEach((tab) => tab.classList.remove('active'));
      newTab.classList.add('active');
      updateStatusBar(filename);
      switchContent(filename);
    });

    tabBar.appendChild(newTab);
    updateStatusBar(filename);
    switchContent(filename);
  }) as EventListener);

  // Helper function to generate file icon HTML
  function getFileIconHTML(filename: string): string {
    const ext = filename.split('.').pop()?.toLowerCase() || '';

    const colorMap: Record<string, string> = {
      md: 'text-ide-accent',
      json: 'text-ide-warning',
      ts: 'text-ide-keyword',
      tsx: 'text-ide-type',
      js: 'text-ide-warning',
      yaml: 'text-ide-error',
      txt: 'text-ide-textMuted',
    };

    const color = colorMap[ext] || 'text-ide-text';

    // Return simplified file icon SVG
    return `<svg class="w-4 h-4 ${color}" viewBox="0 0 24 24" fill="currentColor">
      <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
      <polyline points="14 2 14 8 20 8" fill="none" stroke="currentColor" stroke-width="1"></polyline>
    </svg>`;
  }

  // Handle existing tab close buttons
  document.querySelectorAll('.tab-close').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const tab = btn.closest('.tab');
      if (tab) {
        const tabBar = tab.parentElement;
        tab.remove();
        const remainingTabs = tabBar?.querySelectorAll('.tab');
        if (remainingTabs && remainingTabs.length > 0) {
          remainingTabs[0].classList.add('active');
          // Update status bar and content for newly active tab
          const activeFile = remainingTabs[0].getAttribute('data-file');
          if (activeFile) {
            updateStatusBar(activeFile);
            switchContent(activeFile);
          }
        }
      }
    });
  });

  // Handle existing tab clicks
  document.querySelectorAll('.tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const tabBar = tab.parentElement;
      tabBar?.querySelectorAll('.tab').forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      // Update status bar and content for clicked tab
      const filename = tab.getAttribute('data-file');
      if (filename) {
        updateStatusBar(filename);
        switchContent(filename);
      }
    });
  });

  // Timeline expand/collapse functionality
  document.querySelectorAll('.timeline-entry').forEach((entry) => {
    const commitButton = entry.querySelector('.timeline-commit');

    commitButton?.addEventListener('click', () => {
      const isExpanded = entry.getAttribute('data-expanded') === 'true';
      entry.setAttribute('data-expanded', String(!isExpanded));
      commitButton.setAttribute('aria-expanded', String(!isExpanded));
    });
  });
</script>
