            class="code-block"><code><span class="line"><span class="line-number"> 1</span><span class="syntax-comment">// skills.ts - Technical Skills & Expertise</span></span>
<span class="line"><span class="line-number"> 2</span><span class="syntax-comment">// Last updated: 2026</span></span>
<span class="line"><span class="line-number"> 3</span></span>
<span class="line"><span class="line-number"> 4</span><span class="syntax-keyword">interface</span> <span class="syntax-type">Developer</span> &#123;</span>
<span class="line"><span class="line-number"> 5</span>  <span class="syntax-variable">languages</span>: <span class="syntax-type">string</span>[];</span>
