---
import IDELayout from '@layouts/IDELayout.astro';
import FileExplorer from '@components/FileExplorer.astro';
import FileIcon from '@components/FileIcon.astro';
import '@styles/global.css';

// Section components
import ReadmeSection from '@components/sections/ReadmeSection.astro';
import AboutSection from '@components/sections/AboutSection.astro';
import SkillsSection from '@components/sections/SkillsSection.astro';
import ContactSection from '@components/sections/ContactSection.astro';
import EducationSection from '@components/sections/EducationSection.astro';
import ExperienceSection from '@components/sections/ExperienceSection.astro';
import ArticleSection from '@components/sections/ArticleSection.astro';
import SecretsSection from '@components/sections/SecretsSection.astro';

// Data and helpers
import {
  resume,
  getCurrentPositions,
  getSkillsByDisplayCategory,
  formatEducationPeriod,
  formatDateRange,
} from '../data/resume';

// Prepare data for components
const currentPositions = getCurrentPositions();
const skills = getSkillsByDisplayCategory();
---

<IDELayout title={`${resume.contact.name} - IDE Resume`}>
  <!-- Sidebar: File Explorer -->
  <Fragment slot="sidebar">
    <FileExplorer />
  </Fragment>

  <!-- Tabs -->
  <Fragment slot="tabs">
    <div class="tab active" data-file="README.md">
      <FileIcon filename="README.md" />
      <span class="truncate">README.md</span>
      <button class="tab-close" aria-label="Close tab">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6L18 18"></path>
        </svg>
      </button>
    </div>
  </Fragment>

  <!-- Editor Content Area -->
  <div class="editor-content-area">
    <!-- Main content sections -->
    <ReadmeSection resume={resume} currentPositions={currentPositions} />
    <AboutSection resume={resume} currentPositions={currentPositions} />
    <SkillsSection skills={skills} />
    <ContactSection resume={resume} />
    <EducationSection resume={resume} formatEducationPeriod={formatEducationPeriod} />
    <ExperienceSection workExperience={resume.workExperience} formatDateRange={formatDateRange} />

    <!-- Article sections -->
    <ArticleSection filename="entity-framework-mysql.md" />
    <ArticleSection filename="other-projects.md" />

    <!-- Secret/Easter egg sections -->
    <SecretsSection resume={resume} />
  </div>
</IDELayout>

<script>
  import { activateTab, initExistingTabCloseButtons, initExistingTabClickHandlers } from '../lib/tabs';
  import { getFileIconHTML } from '../lib/editor-utils';
  import { initTimeline } from '../lib/timeline';
  import { initContactForm } from '../lib/form';
  import { initKonami } from '../lib/konami';
  import { unlockAchievement, checkTabHoarder, initAchievements } from '../lib/achievements';

  // Initialize tab handlers
  initExistingTabCloseButtons();
  initExistingTabClickHandlers();

  // Initialize interactive features
  initTimeline();
  initContactForm();
  initKonami(unlockAchievement);
  initAchievements();

  // Listen for file open events to handle tab switching and achievements
  window.addEventListener('file-open', ((event: CustomEvent<{ filename: string }>) => {
    const { filename } = event.detail;
    activateTab(filename, getFileIconHTML);

    // Achievement triggers
    if (['konami.md', 'achievements.unlock', 'career.log'].includes(filename)) {
      unlockAchievement('SECRET_HUNTER');
    }
    if (filename === 'rafael.config.js') unlockAchievement('CONFIG_READER');
    if (filename === 'career.log') unlockAchievement('CAREER_ARCHAEOLOGIST');
    setTimeout(checkTabHoarder, 100);
  }) as EventListener);
</script>
