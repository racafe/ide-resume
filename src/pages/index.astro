          <!-- Closing Tags -->
          <pre
            class="code-block"><code><span class="line"><span class="line-number">49</span></span>
<span class="line"><span class="line-number">50</span>    &lt;/<span class="syntax-type">form</span>&gt;</span>
<span class="line"><span class="line-number">51</span>  );</span>
<span class="line"><span class="line-number">52</span>&#125;;</span>
<span class="line"><span class="line-number">53</span></span>
<span class="line"><span class="line-number">54</span><span class="syntax-keyword">export default</span> <span class="syntax-function">ContactForm</span>;</span></code></pre>
        </div>

        <!-- Success State -->
        <div class="tsx-success hidden" id="contact-success">
          <pre
            class="code-block"><code><span class="line"><span class="line-number">56</span><span class="syntax-comment">// ✓ Component rendered successfully</span></span>
<span class="line"><span class="line-number">57</span><span class="syntax-comment">// Message sent to: rafael@racafe.dev</span></span>
<span class="line"><span class="line-number">58</span></span>
<span class="line"><span class="line-number">59</span><span class="syntax-keyword">const</span> <span class="syntax-variable">response</span>: <span class="syntax-type">ApiResponse</span> = &#123;</span>
<span class="line"><span class="line-number">60</span>  <span class="syntax-variable">status</span>: <span class="syntax-number">200</span>,</span>
<span class="line"><span class="line-number">61</span>  <span class="syntax-variable">message</span>: <span class="syntax-string">"Thank you! I'll get back to you soon."</span>,</span>
<span class="line"><span class="line-number">62</span>  <span class="syntax-variable">timestamp</span>: <span class="syntax-keyword">new</span> <span class="syntax-type">Date</span>().<span class="syntax-function">toISOString</span>()</span>
<span class="line"><span class="line-number">63</span>&#125;;</span>
<span class="line"><span class="line-number">64</span></span>
<span class="line"><span class="line-number">65</span><span class="syntax-variable">console</span>.<span class="syntax-function">log</span>(<span class="syntax-string">'✓ Email queued for delivery'</span>);</span></code></pre>
          <button id="contact-reset" class="tsx-reset-btn">
            <span class="syntax-function">resetForm</span><span class="syntax-punctuation">()</span>
          </button>
        </div>
      </div>
    </div>

    <!-- education.yaml Content - YAML Syntax Highlighted Display -->
    <div class="file-content" data-content="education.yaml">
      <div class="code-editor">
        <div class="code-content">
          <pre
            class="code-block"><code><span class="line"><span class="line-number"> 1</span><span class="syntax-comment"># education.yaml - Education & Certifications</span></span>
