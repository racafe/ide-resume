---
import ChatToggle from '@components/ChatToggle.astro';
import ChatPanel from '@components/ChatPanel.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rafael Carrión - IDE Resume',
  description = 'Full-Stack Developer Portfolio styled as a VS Code IDE. Barcelona-based developer specializing in C#, .NET, TypeScript, and modern web technologies.',
} = Astro.props;

const siteUrl = 'https://rafaelcarrion.dev';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Rafael Carrión" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Preconnect to external resources -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Optimized Google Fonts loading with display=swap for better FCP -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="rafaelcarrion.dev" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${siteUrl}/og-image.svg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rafael Carrión - Full-Stack Developer Portfolio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.svg`} />
    <meta name="twitter:image:alt" content="Rafael Carrión - Full-Stack Developer Portfolio" />

    <!-- Theme color for mobile browsers -->
    <meta name="theme-color" content="#1e1e1e" />

    <!-- Structured Data / JSON-LD -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        'name': 'Rafael Carrión',
        'url': siteUrl,
        'jobTitle': 'Full-Stack Developer',
        'worksFor': {
          '@type': 'Organization',
          'name': 'Funditec',
        },
        'address': {
          '@type': 'PostalAddress',
          'addressLocality': 'Barcelona',
          'addressCountry': 'ES',
        },
        'knowsAbout': ['C#', '.NET', 'TypeScript', 'JavaScript', 'React', 'Docker', 'SQL', 'Entity Framework'],
        'sameAs': ['https://github.com/racafe', 'https://linkedin.com/in/rafaelcarrion'],
      })}
    />

    <title>{title}</title>
  </head>
  <body>
    <!-- Loading Screen -->
    <div id="loading-screen" class="loading-screen">
      <div class="loading-logo">
        <svg width="80" height="80" viewBox="0 0 100 100" fill="currentColor">
          <path d="M95 50L75 30V45H55V30L35 50L55 70V55H75V70L95 50Z"></path>
          <path d="M5 50L25 30V45H45V30L65 50L45 70V55H25V70L5 50Z" opacity="0.5"></path>
        </svg>
      </div>
      <div class="loading-text">racafe IDE</div>
      <div class="loading-bar-container">
        <div class="loading-bar"></div>
      </div>
      <div class="loading-status">Loading workspace...</div>
    </div>

    <!-- Main IDE Container -->
    <div id="ide-container" class="ide-container opacity-0 transition-opacity duration-300">
      <!-- Mobile Header (visible on small screens) -->
      <header class="mobile-header" id="mobile-header">
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
          <svg
            class="hamburger-icon"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M3 12H21M3 6H21M3 18H21"></path>
          </svg>
          <svg
            class="close-icon hidden"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M18 6L6 18M6 6L18 18"></path>
          </svg>
        </button>
        <div class="mobile-title">
          <svg width="20" height="20" viewBox="0 0 100 100" fill="currentColor" class="text-ide-accent">
            <path d="M95 50L75 30V45H55V30L35 50L55 70V55H75V70L95 50Z"></path>
            <path d="M5 50L25 30V45H45V30L65 50L45 70V55H25V70L5 50Z" opacity="0.5"></path>
          </svg>
          <span>rafaelcarrion.dev</span>
        </div>
        <div class="mobile-tab-selector" id="mobile-tab-selector">
          <button class="mobile-tab-btn" id="mobile-tab-btn" aria-label="Select file" aria-expanded="false">
            <span class="mobile-tab-current" id="mobile-tab-current">README.md</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="mobile-tab-dropdown hidden" id="mobile-tab-dropdown">
            <!-- Populated by JavaScript -->
          </div>
        </div>
      </header>

      <!-- Mobile Sidebar Overlay -->
      <div class="mobile-sidebar-overlay hidden" id="mobile-sidebar-overlay"></div>

      <!-- Main content area with Activity Bar, Sidebar, and Editor -->
      <div class="flex flex-1 overflow-hidden">
        <!-- Activity Bar (leftmost icon strip) -->
        <aside class="activity-bar">
          <button class="activity-bar-icon active" title="Explorer" aria-label="Explorer">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path
                d="M3 7V17C3 18.1 3.9 19 5 19H19C20.1 19 21 18.1 21 17V9C21 7.9 20.1 7 19 7H11L9 5H5C3.9 5 3 5.9 3 7Z"
              >
              </path>
            </svg>
          </button>
          <button class="activity-bar-icon" title="Search" aria-label="Search">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="11" cy="11" r="6"></circle>
              <path d="M21 21L16 16"></path>
            </svg>
          </button>
          <button class="activity-bar-icon" title="Source Control" aria-label="Source Control">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="6" r="3"></circle>
              <circle cx="6" cy="18" r="3"></circle>
              <circle cx="18" cy="18" r="3"></circle>
              <path d="M12 9V12M12 12L6 15M12 12L18 15"></path>
            </svg>
          </button>
          <button class="activity-bar-icon" title="Extensions" aria-label="Extensions">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="8" height="8" rx="1"></rect>
              <rect x="13" y="3" width="8" height="8" rx="1"></rect>
              <rect x="3" y="13" width="8" height="8" rx="1"></rect>
              <rect x="13" y="13" width="8" height="8" rx="1"></rect>
            </svg>
          </button>
          <!-- Chat Toggle (desktop) -->
          <ChatToggle />
        </aside>

        <!-- Sidebar (File Explorer) -->
        <aside class="sidebar" id="sidebar">
          <div class="sidebar-header">Explorer</div>
          <div class="file-tree" id="file-tree">
            <!-- File tree will be populated by components or JavaScript -->
            <slot name="sidebar" />
          </div>
        </aside>

        <!-- Editor Area -->
        <main class="editor-area">
          <!-- Tab Bar with Scroll Indicators -->
          <div class="tab-bar-container">
            <button
              class="tab-scroll-indicator tab-scroll-indicator-left"
              id="tab-scroll-left"
              aria-label="Scroll tabs left"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <div class="tab-bar" id="tab-bar">
              <slot name="tabs" />
            </div>
            <button
              class="tab-scroll-indicator tab-scroll-indicator-right"
              id="tab-scroll-right"
              aria-label="Scroll tabs right"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>

          <!-- Editor Content -->
          <div class="editor-content" id="editor-content">
            <slot />
          </div>
        </main>
      </div>

      <!-- Status Bar -->
      <footer class="status-bar">
        <div class="flex items-center">
          <span class="status-bar-item" title="Current branch: main (click to checkout)">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="6" r="3"></circle>
              <circle cx="6" cy="18" r="3"></circle>
              <circle cx="18" cy="18" r="3"></circle>
              <path d="M12 9V12M12 12L6 15M12 12L18 15"></path>
            </svg>
            main
          </span>
          <span class="status-bar-item hide-on-mobile" id="status-file-type" title="File type">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
              <polyline points="14 2 14 8 20 8" fill="none" stroke="currentColor" stroke-width="1"></polyline>
            </svg>
            <span id="status-file-type-text">Markdown</span>
          </span>
          <span class="status-bar-item hide-on-mobile" title="0 Errors - click to view">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2V22M2 12H22"></path>
            </svg>
            0
          </span>
          <span class="status-bar-item hide-on-mobile" title="0 Warnings - click to view">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 9V13M12 17H12.01M21 12A9 9 0 1 1 3 12A9 9 0 0 1 21 12Z"></path>
            </svg>
            0
          </span>
        </div>
        <div class="flex items-center">
          <span class="status-bar-item hide-on-mobile" id="status-line-col" title="Go to Line/Column">Ln 1, Col 1</span>
          <span class="status-bar-item hide-on-mobile" id="status-encoding" title="Select Encoding">UTF-8</span>
          <span class="status-bar-item" id="status-language" title="Select Language Mode">Markdown</span>
        </div>
      </footer>
    </div>

    <script>
      // Loading screen animation - optimized for fast FCP
      document.addEventListener('DOMContentLoaded', () => {
        const loadingScreen = document.getElementById('loading-screen');
        const ideContainer = document.getElementById('ide-container');
        const loadingStatus = document.querySelector('.loading-status');

        // Respect reduced motion preference - skip animation entirely
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (prefersReducedMotion) {
          // Skip loading animation for users who prefer reduced motion
          if (loadingScreen) loadingScreen.style.display = 'none';
          if (ideContainer) ideContainer.classList.remove('opacity-0');
        } else {
          const loadingSteps = ['Loading workspace...', 'Initializing...', 'Ready!'];
          let stepIndex = 0;

          const stepInterval = setInterval(() => {
            stepIndex++;
            if (stepIndex < loadingSteps.length && loadingStatus) {
              loadingStatus.textContent = loadingSteps[stepIndex];
            }
          }, 300);

          // Reduced loading time from 2s to 1s for faster FCP
          setTimeout(() => {
            clearInterval(stepInterval);
            if (loadingScreen) {
              loadingScreen.style.opacity = '0';
              loadingScreen.style.transition = 'opacity 0.2s ease-out';
            }
            if (ideContainer) {
              ideContainer.classList.remove('opacity-0');
            }
            setTimeout(() => {
              if (loadingScreen) {
                loadingScreen.style.display = 'none';
              }
            }, 200);
          }, 1000);
        }

        // Tab bar scroll handling
        const tabBar = document.getElementById('tab-bar');
        const scrollLeft = document.getElementById('tab-scroll-left');
        const scrollRight = document.getElementById('tab-scroll-right');

        function updateScrollIndicators() {
          if (!tabBar || !scrollLeft || !scrollRight) return;

          const canScrollLeft = tabBar.scrollLeft > 0;
          const canScrollRight = tabBar.scrollLeft < tabBar.scrollWidth - tabBar.clientWidth - 1;

          scrollLeft.classList.toggle('visible', canScrollLeft);
          scrollRight.classList.toggle('visible', canScrollRight);
        }

        // Update indicators on scroll
        tabBar?.addEventListener('scroll', updateScrollIndicators);

        // Click to scroll
        scrollLeft?.addEventListener('click', () => {
          tabBar?.scrollBy({ left: -150, behavior: 'smooth' });
        });

        scrollRight?.addEventListener('click', () => {
          tabBar?.scrollBy({ left: 150, behavior: 'smooth' });
        });

        // Horizontal mouse wheel scrolling on tab bar
        tabBar?.addEventListener('wheel', (e) => {
          if (e.deltaY !== 0) {
            e.preventDefault();
            tabBar.scrollBy({ left: e.deltaY, behavior: 'auto' });
          }
        });

        // Observe DOM changes to update indicators when tabs are added/removed
        const observer = new MutationObserver(updateScrollIndicators);
        if (tabBar) {
          observer.observe(tabBar, { childList: true });
        }

        // Initial check after a short delay to ensure layout is complete
        setTimeout(updateScrollIndicators, 100);
        window.addEventListener('resize', updateScrollIndicators);

        // Mobile sidebar toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('mobile-sidebar-overlay');
        const hamburgerIcon = mobileMenuBtn?.querySelector('.hamburger-icon');
        const closeIcon = mobileMenuBtn?.querySelector('.close-icon');

        function toggleMobileSidebar(open?: boolean) {
          const isOpen = open ?? !sidebar?.classList.contains('mobile-open');

          if (isOpen) {
            sidebar?.classList.add('mobile-open');
            sidebarOverlay?.classList.remove('hidden');
            hamburgerIcon?.classList.add('hidden');
            closeIcon?.classList.remove('hidden');
            mobileMenuBtn?.setAttribute('aria-expanded', 'true');
            document.body.classList.add('mobile-menu-open');
          } else {
            sidebar?.classList.remove('mobile-open');
            sidebarOverlay?.classList.add('hidden');
            hamburgerIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
            mobileMenuBtn?.setAttribute('aria-expanded', 'false');
            document.body.classList.remove('mobile-menu-open');
          }
        }

        mobileMenuBtn?.addEventListener('click', () => toggleMobileSidebar());
        sidebarOverlay?.addEventListener('click', () => toggleMobileSidebar(false));

        // Mobile tab dropdown
        const mobileTabBtn = document.getElementById('mobile-tab-btn');
        const mobileTabDropdown = document.getElementById('mobile-tab-dropdown');
        const mobileTabCurrent = document.getElementById('mobile-tab-current');

        function toggleMobileTabDropdown(open?: boolean) {
          const isOpen = open ?? mobileTabDropdown?.classList.contains('hidden');

          if (isOpen) {
            mobileTabDropdown?.classList.remove('hidden');
            mobileTabBtn?.setAttribute('aria-expanded', 'true');
            updateMobileTabDropdown();
          } else {
            mobileTabDropdown?.classList.add('hidden');
            mobileTabBtn?.setAttribute('aria-expanded', 'false');
          }
        }

        function updateMobileTabDropdown() {
          if (!mobileTabDropdown || !tabBar) return;

          const tabs = tabBar.querySelectorAll('.tab');
          mobileTabDropdown.innerHTML = '';

          tabs.forEach((tab) => {
            const filename = tab.getAttribute('data-file');
            const isActive = tab.classList.contains('active');

            const option = document.createElement('button');
            option.className = `mobile-tab-option ${isActive ? 'active' : ''}`;
            option.textContent = filename || '';
            option.addEventListener('click', () => {
              tab.dispatchEvent(new MouseEvent('click', { bubbles: true }));
              toggleMobileTabDropdown(false);
            });

            mobileTabDropdown.appendChild(option);
          });
        }

        function updateMobileTabCurrent(filename: string) {
          if (mobileTabCurrent) {
            mobileTabCurrent.textContent = filename;
          }
        }

        mobileTabBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleMobileTabDropdown();
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
          if (!mobileTabBtn?.contains(e.target as Node) && !mobileTabDropdown?.contains(e.target as Node)) {
            toggleMobileTabDropdown(false);
          }
        });

        // Listen for tab changes to update mobile tab selector
        const tabObserver = new MutationObserver(() => {
          const activeTab = tabBar?.querySelector('.tab.active');
          if (activeTab) {
            const filename = activeTab.getAttribute('data-file');
            if (filename) updateMobileTabCurrent(filename);
          }
        });

        if (tabBar) {
          tabObserver.observe(tabBar, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['class'],
          });
        }

        // Close mobile sidebar when a file is clicked
        window.addEventListener('file-open', () => {
          toggleMobileSidebar(false);
        });
      });
    </script>

    <style>
      /* Ensure smooth loading transition */
      #loading-screen {
        transition: opacity 0.3s ease-out;
      }
    </style>

    <!-- Konami Code Easter Egg Game Modal -->
    <div id="game-modal" class="game-modal hidden">
      <div class="game-modal-backdrop"></div>
      <div class="game-modal-content">
        <div class="game-header">
          <div class="game-title">
            <svg class="w-5 h-5 text-ide-string" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4-3c-.83 0-1.5-.67-1.5-1.5S18.67 9 19.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"
              >
              </path>
            </svg>
            <span>Snake Game</span>
          </div>
          <button id="game-close" class="game-close-btn" aria-label="Close game">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6L18 18"></path>
            </svg>
          </button>
        </div>
        <div class="game-stats">
          <div class="game-stat">
            <span class="game-stat-label">Score:</span>
            <span id="game-score" class="game-stat-value">0</span>
          </div>
          <div class="game-stat">
            <span class="game-stat-label">High Score:</span>
            <span id="game-high-score" class="game-stat-value">0</span>
          </div>
        </div>
        <div class="game-canvas-container">
          <canvas id="game-canvas" width="400" height="400"></canvas>
          <div id="game-overlay" class="game-overlay">
            <div class="game-overlay-content">
              <div id="game-message" class="game-message">Press SPACE to start</div>
              <div class="game-controls">
                <span class="syntax-comment">// Use arrow keys to move</span>
              </div>
            </div>
          </div>
        </div>
        <div class="game-footer">
          <span class="syntax-comment">// Press ESC to close</span>
        </div>
      </div>
    </div>

    <!-- Achievement Toast Container -->
    <div id="achievement-toast-container" class="achievement-toast-container"></div>

    <!-- Chat Panel -->
    <ChatPanel />
  </body>
</html>
